---
import Logo from "./Logo.astro";
import { site, hai } from "../data/site.ts";
const year = new Date().getFullYear();
---

<footer class="ft">
  <div class="container ft__grid">
    <div class="ft__brand">
      <a href="/" aria-label="Front of House home">
        <Logo />
      </a>
      <p>
        A creative studio.
        <br />A restaurant state of mind.
      </p>
    </div>
    <nav aria-label="Footer studio">
      <p class="ft__label">Take a look around</p>
      <a href="/work">Our work</a>
      <a href="/services">What we do</a>
      <a href="/about">The studio</a>
      <a href="/pricing">Pricing</a>
    </nav>
    <nav aria-label="Footer resources">
      <p class="ft__label">Make yourself at home</p>
      <a href="/templates">Templates</a>
      <a href="/websites-for-restaurants">Restaurant websites</a>
      <a href="/contact">Start a project</a>
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms of Service</a>
      <a href="/providers">Hosting &amp; providers</a>
    </nav>
    <div class="ft__contact">
      <p class="ft__label">Say hello</p>
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      <a href={site.contact.phoneHref}>{site.contact.phone}</a>
      <p class="ft__place">
        Utah &amp; Georgia.
        <br />
        Built for your neighborhood.
      </p>
    </div>
  </div>
  <div class="container">
    <div class="ft__big" aria-hidden="true">
      Front of House<span>↗</span>
    </div>
  </div>
  <div class="container ft__base">
    <p>© {year} Front of House. All welcome.</p>
    <p>
      Co-founded with talent from{" "}
      <a href={hai.url} target="_blank" rel="noopener noreferrer">
        {hai.longName}
      </a>
    </p>
    <a href="#main">Back to top ↑</a>
  </div>
</footer>
<style>
  .ft {
    padding-top: 4.5rem;
    background: var(--paper);
    border-top: 1px solid var(--line);
  }
  .ft__grid {
    display: grid;
    grid-template-columns: 1.45fr 1fr 1.25fr 1.25fr;
    gap: 2rem;
  }
  .ft__brand p {
    font-size: 0.85rem;
    margin-top: 1.5rem;
  }
  .ft nav,
  .ft__contact {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }
  .ft__label {
    font-size: 0.61rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-weight: 600;
    color: var(--muted);
    margin: 0 0 1rem;
  }
  .ft nav a,
  .ft__contact a {
    font-size: 0.76rem;
    color: var(--ink);
  }
  .ft nav a:hover,
  .ft__contact a:hover {
    color: var(--ember);
  }
  .ft__place {
    font-size: 0.75rem;
    margin-top: 1rem;
    color: var(--muted);
  }
  .ft__big {
    font-family: var(--display);
    font-size: clamp(3.1rem, 11.75vw, 10.7rem);
    font-weight: 600;
    letter-spacing: -0.065em;
    line-height: 1.3;
    margin-top: 3rem;
    color: var(--ember);
    white-space: nowrap;
    position: relative;
  }
  .ft__big span {
    display: inline-block;
    font-family: var(--sans);
    font-size: 0.14em;
    vertical-align: top;
    padding-top: 1.3em;
    letter-spacing: 0;
    margin-left: 0.3em;
  }
  .ft__base {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding-block: 1.4rem 2rem;
    border-top: 1px solid var(--line);
    font-size: 0.65rem;
    color: var(--muted);
  }
  .ft__base p {
    margin: 0;
  }
  .ft__base a {
    color: var(--body);
  }
  .ft__base p a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  @media (max-width: 850px) {
    .ft__grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
    .ft__base {
      flex-wrap: wrap;
    }
    .ft__big {
      margin-top: 2rem;
    }
  }
  @media (max-width: 440px) {
    .ft__grid {
      gap: 2rem 1rem;
    }
    .ft__contact a {
      overflow-wrap: anywhere;
    }
    .ft__base {
      align-items: flex-start;
      flex-direction: column;
    }
    .ft__big {
      font-size: 11.1vw;
    }
    .ft__label {
      font-size: 0.57rem;
    }
  }
</style>
