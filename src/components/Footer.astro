---
// Close and footer in one ink field: an invitation with the one action, the practical facts,
// and the name set as wide as the page, its descent cropped by the bottom edge.
import { site, hai, cta } from "../data/site.ts";
const year = new Date().getFullYear();
const links = [
  { label: "Work", href: "/work" },
  { label: "Services", href: "/services" },
  { label: "Pricing", href: "/pricing" },
  { label: "Templates", href: "/templates" },
  { label: "About", href: "/about" },
  { label: "Restaurant websites", href: "/websites-for-restaurants" },
  { label: "Compare studios", href: "/restaurant-website-companies" },
  { label: "Contact", href: "/contact" },
];
const ctaHref = Astro.url.pathname === "/" ? "#talk" : "/contact";
---

<footer class="ft">
  <div class="ft__top">
    <div class="ft__invite">
      <h2 class="ft__h">Your new front of house.</h2>
      <a href={ctaHref} class="btn btn--primary">{cta.label}</a>
    </div>
    <address class="ft__facts">
      <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
      <a href={site.contact.phoneHref}>{site.contact.phone}</a>
      <span>Park City and Salt Lake City, Utah</span>
      <span>Metro Atlanta, Georgia</span>
      <button class="ft__host" type="button" data-open-host aria-controls="maitre-panel" aria-expanded="false">Ask the Host, our AI</button>
    </address>
  </div>

  <nav class="ft__links" aria-label="Footer">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>

  <div class="ft__legal small">
    <span>&copy; {year} {site.name}. Built only for restaurants.</span>
    <span>
      Co-founded with the team from <a href={hai.url} target="_blank" rel="noopener noreferrer">{hai.longName}</a>, who built Killa and Burger Lab. <a href="/privacy">Privacy</a>
    </span>
  </div>

  <svg class="ft__name" viewBox="0 0 1000 150" role="img" aria-label={site.name} preserveAspectRatio="xMinYMin meet">
    <text x="0" y="138" textLength="1000" lengthAdjust="spacingAndGlyphs">Front of House</text>
  </svg>
</footer>

<style>
  .ft {
    position: relative;
    overflow: hidden;
    margin-top: var(--section);
    display: grid;
    grid-template-rows: auto auto auto auto;
    gap: 2.5rem;
    padding: clamp(3.5rem, 7vw, 6rem) var(--margin) 0;
    background: var(--ink);
    color: var(--paper);
  }
  .ft a { color: var(--paper); text-decoration: none; }
  .ft a:hover { text-decoration: underline; }
  .ft__top {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 2.5rem;
  }
  .ft__invite { grid-column: 1 / 8; display: grid; gap: 2rem; justify-items: start; align-content: start; }
  .ft__h { font-size: var(--step-head); max-width: 14ch; color: var(--paper); }
  .ft__invite .btn { color: var(--paper); text-decoration: none; }
  .ft__facts {
    grid-column: 10 / 13;
    display: grid; gap: 0.6rem; align-content: start;
    font-style: normal; color: var(--muted-on-ink);
  }
  .ft__facts a { color: var(--paper); }
  .ft__host {
    justify-self: start; margin-top: 0.5rem; min-height: 2.75rem; padding: 0; background: none; border: 0;
    color: var(--paper); font-weight: 600; text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer;
  }
  .ft__host:hover { color: var(--ember-bright); }
  .ft__links { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; }
  .ft__legal {
    display: flex; justify-content: space-between; gap: 1rem 2rem; flex-wrap: wrap;
    color: var(--muted-on-ink);
  }
  .ft__legal a { text-decoration: underline; color: var(--muted-on-ink); }
  .ft__name {
    align-self: end;
    width: calc(100% + 2 * var(--margin));
    max-width: none;
    margin: 0 calc(-1 * var(--margin));
    height: auto;
    overflow: visible;
    margin-top: clamp(1rem, 4vw, 3rem);
    transform: translateY(14%);
  }
  .ft__name text {
    font-family: var(--display);
    font-weight: 700;
    font-size: 176px;
    letter-spacing: -0.02em;
    fill: var(--toast);
  }
  @media (max-width: 760px) {
    .ft__invite, .ft__facts { grid-column: 1 / -1; }
    .ft__invite .btn { width: 100%; }
    .ft__links { gap: 0.5rem 1.25rem; }
  }
</style>
