---
// A plain bar: the awning wordmark, five links, one action. No sticky glass, no hairline.
// On a phone the links move into a full-screen sheet opened by a text button.
import Logo from "./Logo.astro";
import { nav, site, cta } from "../data/site.ts";
const path = Astro.url.pathname;
const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
// On the home page the inquiry form is on the page itself.
const ctaHref = path === "/" ? "#talk" : "/contact";
---

<header class="hd">
  <a href="/" class="hd__brand" aria-label={`${site.name} home`}>
    <Logo variant="inline" />
    <span class="hd__name">Front of House</span>
  </a>

  <nav class="hd__nav" aria-label="Primary">
    {
      nav.map((item) => (
        <a href={item.href} class="hd__link" aria-current={isActive(item.href) ? "page" : undefined}>
          {item.label}
        </a>
      ))
    }
  </nav>

  <button class="hd__host" type="button" data-open-host aria-controls="maitre-panel" aria-expanded="false">Ask the Host</button>
  <a href={ctaHref} class="btn btn--primary btn--small hd__cta">{cta.label}</a>
  <button class="hd__toggle" type="button" aria-expanded="false" aria-controls="sheet">Menu</button>
</header>

<div class="sheet" id="sheet" data-open="false" aria-label="Site menu">
  <button class="sheet__close" type="button">Close</button>
  <a href="/">Home</a>
  {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  <a href="/contact">Contact</a>
  <button class="sheet__host" type="button" data-open-host aria-controls="maitre-panel" aria-expanded="false">Ask the Host, our AI</button>
  <a class="btn btn--primary sheet__go" href={ctaHref}>{cta.label}</a>
</div>

<style>
  .hd {
    position: relative;
    z-index: 30;
    display: flex;
    align-items: center;
    gap: var(--gutter);
    padding: 1rem var(--margin);
    background: var(--bg);
  }
  .hd__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    margin-right: auto;
    text-decoration: none;
    color: var(--ink);
  }
  .hd__name {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: -0.01em;
  }
  /* The inline lockup shows FOH next to the awning; the full name reads better here. */
  .hd__brand :global(.logo__type) { display: none; }
  .hd__nav { display: flex; gap: clamp(1rem, 2.2vw, 2rem); }
  .hd__link {
    position: relative;
    padding-block: 0.45rem;
    text-decoration: none;
    font-weight: 500;
    color: var(--ink);
  }
  .hd__link::after {
    content: "";
    position: absolute; left: 0; right: 0; bottom: 0;
    height: 2px; background: currentColor;
    transform: scaleX(0); transform-origin: left;
    transition: transform var(--t-ui) var(--ease-out);
  }
  .hd__link:hover::after,
  .hd__link[aria-current="page"]::after { transform: none; }
  .hd__host {
    min-height: 2.75rem;
    padding: 0 0.25rem;
    background: none;
    border: 0;
    font-weight: 500;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .hd__host:hover { color: var(--ember-deep); }
  .hd__toggle {
    display: none;
    min-height: 2.75rem;
    padding: 0 0.25rem;
    background: none;
    border: 0;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
  .sheet { display: none; }

  @media (max-width: 900px) {
    .hd__nav { display: none; }
    .hd__toggle { display: inline-block; }
  }
  @media (max-width: 1100px) {
    .hd__host { display: none; }
  }
  @media (max-width: 560px) {
    .hd__cta { display: none; }
  }
  @media (max-width: 900px) {
    .sheet {
      position: fixed; inset: 0; z-index: 60;
      display: flex; flex-direction: column; gap: 0.35rem;
      padding: 1rem var(--margin) 2rem;
      background: var(--ink); color: var(--paper);
      transform: translateY(-100%); visibility: hidden;
      transition: transform 360ms var(--ease-out), visibility 0s linear 360ms;
    }
    .sheet[data-open="true"] { transform: none; visibility: visible; transition: transform 360ms var(--ease-out); }
    .sheet a:not(.btn) {
      font-family: var(--display); font-weight: 600; font-size: var(--step-head);
      line-height: 1.15; text-decoration: none; color: var(--paper);
    }
    .sheet__close {
      align-self: flex-end; min-height: 2.75rem; background: none; border: 0; color: var(--paper);
      font-weight: 600; text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer;
    }
    .sheet__host {
      align-self: flex-start; margin-top: 1rem; min-height: 2.75rem; padding: 0; background: none; border: 0;
      color: var(--paper); font-weight: 600; text-decoration: underline; text-underline-offset: 0.2em; cursor: pointer;
    }
    .sheet__go { margin-top: auto; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".hd__toggle");
  const sheet = document.getElementById("sheet");
  const close = sheet?.querySelector<HTMLButtonElement>(".sheet__close");
  const setOpen = (open: boolean) => {
    if (!sheet || !toggle) return;
    sheet.dataset.open = String(open);
    toggle.setAttribute("aria-expanded", String(open));
    if (open) sheet.querySelector<HTMLElement>("a")?.focus();
    else toggle.focus();
  };
  toggle?.addEventListener("click", () => setOpen(true));
  close?.addEventListener("click", () => setOpen(false));
  sheet?.querySelectorAll("a").forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && sheet?.dataset.open === "true") setOpen(false);
  });
</script>
