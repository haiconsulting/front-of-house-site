---
import Logo from "./Logo.astro";
import { site } from "../data/site.ts";
const links = [
  { label: "Our work", href: "/work" },
  { label: "Templates", href: "/templates" },
  { label: "What we do", href: "/services" },
  { label: "The studio", href: "/about" },
  { label: "Pricing", href: "/pricing" },
];
const isActive = (href: string) => Astro.url.pathname.startsWith(href);
---

<header class="hd">
  <div class="container hd__bar">
    <a href="/" class="hd__brand" aria-label={`${site.name} home`}>
      <Logo />
    </a>
    <nav class="hd__nav" aria-label="Primary">
      {links.map((item) => (
        <a
          href={item.href}
          aria-current={isActive(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
    <div class="hd__actions">
      <a href="/contact" class="btn btn--primary hd__cta">
        Let's talk <span aria-hidden="true">↗</span>
      </a>
      <button
        class="hd__toggle"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
  <nav id="mobile-nav" class="hd__mobile" aria-label="Mobile" hidden>
    {links.map((item) => (
      <a
        href={item.href}
        aria-current={isActive(item.href) ? "page" : undefined}
      >
        {item.label}
      </a>
    ))}
    <a href="/contact">
      Let's talk <span aria-hidden="true">↗</span>
    </a>
  </nav>
</header>
<style>
  .hd {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--line);
  }
  .hd__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    min-height: 101px;
  }
  .hd__brand {
    display: flex;
  }
  .hd__nav {
    display: flex;
    gap: 2.25rem;
    margin-left: auto;
    margin-right: 2rem;
  }
  .hd__nav a {
    font-size: 0.78rem;
    color: var(--ink);
    padding: 0.8rem 0;
  }
  .hd__nav a:hover,
  .hd__nav a[aria-current] {
    color: var(--ember);
  }
  .hd__nav a[aria-current] {
    text-decoration: underline;
    text-underline-offset: 6px;
  }
  .hd__cta {
    min-height: 43px;
    padding: 0.65rem 1.2rem;
    font-size: 0.75rem;
    gap: 2rem;
  }
  .hd__actions {
    display: flex;
    gap: 1rem;
    align-items: center;
  }
  .hd__toggle {
    display: none;
    background: none;
    border: 1px solid var(--line);
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    color: var(--ink);
  }
  .hd__toggle span {
    width: 19px;
    height: 1px;
    background: currentColor;
    transition: transform 0.2s;
  }
  .hd__toggle[aria-expanded="true"] span:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }
  .hd__toggle[aria-expanded="true"] span:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }
  .hd__mobile {
    padding: 0.5rem var(--gutter) 1.5rem;
    border-top: 1px solid var(--line);
  }
  .hd__mobile a {
    display: flex;
    justify-content: space-between;
    padding: 0.7rem 0;
    color: var(--ink);
    border-bottom: 1px solid var(--line);
    font-size: 1rem;
  }
  .hd__mobile[hidden] {
    display: none;
  }
  @media (max-width: 900px) {
    .hd__bar {
      min-height: 83px;
    }
    .hd__nav {
      display: none;
    }
    .hd__toggle {
      display: flex;
    }
  }
  @media (min-width: 901px) {
    .hd__mobile {
      display: none;
    }
  }
  @media (max-width: 390px) {
    .hd__cta {
      display: none;
    }
  }
</style>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".hd__toggle");
  const menu = document.getElementById("mobile-nav");
  const close = () => {
    menu?.setAttribute("hidden", "");
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open navigation");
  };
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    if (open) close();
    else {
      menu?.removeAttribute("hidden");
      toggle.setAttribute("aria-expanded", "true");
      toggle.setAttribute("aria-label", "Close navigation");
    }
  });
  document.addEventListener("keydown", (e) => {
    if (
      e.key === "Escape" &&
      toggle?.getAttribute("aria-expanded") === "true"
    ) {
      close();
      toggle.focus();
    }
  });
  menu
    ?.querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", close));
  window.matchMedia("(min-width:901px)").addEventListener("change", (e) => {
    if (e.matches) close();
  });
</script>
