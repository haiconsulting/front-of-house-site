---
import Logo from "./Logo.astro";
interface Props {
  heading?: string;
  sub?: string;
}
const {
  heading = "Pull up a chair.",
  sub = "Tell us what you're building. We'll bring a few ideas, a clear plan, and a genuine love for your kind of place.",
} = Astro.props;
---

<section class="ctaband" data-od-id="conversation">
  <div class="container ctaband__inner">
    <div>
      <p class="ctaband__label">GOOD THINGS START WITH A CONVERSATION</p>
      <h2>{heading}</h2>
      <p class="ctaband__sub">{sub}</p>
      <a class="btn btn--on-ink" href="/contact">
        Let's talk about your restaurant <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="ctaband__door">
      <Logo variant="mark" theme="reversed" />
    </div>
  </div>
</section>
<style>
  .ctaband {
    background: var(--ember);
    color: var(--paper);
    padding-block: clamp(4rem, 7vw, 7rem);
  }
  .ctaband__inner {
    display: grid;
    grid-template-columns: 1fr 240px;
    align-items: center;
    gap: 4rem;
  }
  .ctaband__label {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    margin: 0 0 1.6rem;
  }
  .ctaband h2 {
    font-size: clamp(3.5rem, 6.7vw, 6.5rem);
    color: var(--paper);
    margin: 0 0 1.2rem;
    max-width: 15ch;
  }
  .ctaband__sub {
    max-width: 48ch;
    margin-bottom: 2rem;
    font-size: 0.95rem;
    color: var(--paper);
  }
  .ctaband__door {
    width: 170px;
    justify-self: center;
    transform: rotate(8deg);
  }
  .ctaband__door :global(.logo) {
    width: 100%;
  }
  .ctaband :focus-visible {
    outline-color: var(--paper);
  }
  @media (max-width: 720px) {
    .ctaband__inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .ctaband__door {
      display: none;
    }
    .ctaband h2 {
      font-size: clamp(3rem, 12vw, 5rem);
    }
  }
</style>
