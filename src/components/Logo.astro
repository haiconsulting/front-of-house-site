---
interface Props {
  variant?: "inline" | "stacked" | "mark";
  theme?: "light" | "reversed" | "mono";
  wordmark?: boolean;
  class?: string;
}
const {
  variant = "inline",
  theme = "light",
  wordmark = true,
  class: klass = "",
} = Astro.props;
---

<span
  class={`logo logo--${variant} logo--${theme} ${klass}`}
  aria-hidden="true"
>
  <svg
    class="logo__mark"
    viewBox="0 0 56 64"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
  >
    <path
      d="M6 57V28C6 15.85 15.85 6 28 6s22 9.85 22 22v29H39V28c0-6.08-4.92-11-11-11s-11 4.92-11 11v29H6Z"
      fill="currentColor"
    />
    <path d="M26 30 39 23v34l-13 7V30Z" fill="currentColor" />
  </svg>
  {variant !== "mark" && (
    <span class="logo__type">
      <span>front of</span>
      <span>
        house<span class="logo__period">.</span>
      </span>
      {variant === "stacked" && wordmark && (
        <small>THE RESTAURANT STUDIO</small>
      )}
    </span>
  )}
</span>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    line-height: 0.88;
    color: var(--ember);
  }
  .logo__mark {
    width: 39px;
    height: 46px;
    flex: none;
  }
  .logo__type {
    display: flex;
    flex-direction: column;
    gap: 0.06em;
    font-family: var(--display);
    font-weight: 700;
    font-size: 1.46rem;
    letter-spacing: -0.065em;
  }
  .logo__period {
    font-family: var(--display);
  }
  .logo--reversed {
    color: var(--paper);
  }
  .logo--mono {
    color: currentColor;
  }
  .logo--stacked {
    flex-direction: column;
    text-align: center;
    gap: 1rem;
  }
  .logo--stacked .logo__mark {
    width: 64px;
    height: auto;
  }
  .logo--stacked .logo__type {
    font-size: 2.6rem;
  }
  .logo__type small {
    font-family: var(--sans);
    font-size: 0.57rem;
    font-weight: 500;
    letter-spacing: 0.15em;
    line-height: 1.5;
    margin-top: 1rem;
  }
  .logo--mark .logo__mark {
    width: 100%;
    height: auto;
  }
</style>
