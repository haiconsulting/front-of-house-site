---
// Work. The restaurants first as one sentence of names with their own frames inside it,
// then each site in full, then the live templates as an index with a preview.
import Base from "../layouts/Base.astro";
import Cases from "../components/Cases.astro";
import LeadForm from "../components/LeadForm.astro";
import { caseStudies, hai, specConcepts, site } from "../data/site.ts";

const ogFor: Record<string, string> = {
  "/templates/fine-dining": "/og/fine-dining.jpg",
  "/templates/fast-casual": "/og/fast-casual.jpg",
  "/templates/cantina": "/og/cantina.jpg",
  "/templates/neighborhood-bar": "/og/neighborhood-bar.jpg",
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Restaurant Websites Built by Front of House",
  description:
    "Custom restaurant websites designed, built and maintained by Front of House. Each site is owned outright by the restaurant owner.",
  itemListElement: [
    ...caseStudies.map((c) => ({ name: c.name, url: c.url, description: c.blurb, cuisine: c.type, city: c.location })),
    { name: "Dasks Greek Grill", url: "https://www.dasks.com", description: "A Greek grill in Salt Lake City with a food-led site and online ordering.", cuisine: "Greek", city: "Salt Lake City, UT" },
  ].map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item: {
      "@type": "WebSite",
      name: c.name,
      url: c.url,
      description: c.description,
      creator: { "@id": `${site.url}/#organization` },
      about: {
        "@type": "Restaurant",
        name: c.name,
        servesCuisine: c.cuisine,
        address: { "@type": "PostalAddress", addressLocality: c.city.split(",")[0].trim(), addressRegion: c.city.split(",")[1]?.trim() },
      },
    },
  })),
};
---

<Base
  title="Work"
  description="Restaurant websites built by Front of House: Killa, Burger Lab and Dasks in Salt Lake City. Custom, fast, mobile first, and owned by the restaurant owner. Plus four live templates to try with your own name."
  jsonLd={jsonLd}
>
  <section class="intro" aria-labelledby="work-title">
    <h1 id="work-title">Restaurant websites we built</h1>
    <p class="names" data-reveal>
      <span>
        <a href="#killa">Killa</a><img class="inline" src="/work/killa-still.jpg" alt="" width="1280" height="720" />,
        <a href="#burger-lab">Burger Lab</a><img class="inline" src="/work/burger-lab-still.jpg" alt="" width="1280" height="720" /> and
        <a href="#dasks">Dasks</a><img class="inline" src="/work/dasks-still.jpg" alt="" width="1280" height="720" />, all owned by the people who run them, plus four live templates to try with your name.
      </span>
    </p>
  </section>

  <Cases detailed />

  <section class="lineage" aria-labelledby="lineage-title">
    <h2 id="lineage-title">Same people, same standard</h2>
    <div class="lineage__text" data-reveal>
      <p>{hai.blurb}</p>
      <p><a class="link" href={hai.url} target="_blank" rel="noopener noreferrer">More of the team's work at {hai.longName}</a></p>
    </div>
  </section>

  <section class="spec" aria-labelledby="spec-title">
    <div class="spec__head" data-reveal>
      <h2 id="spec-title">Your kind of place, live today</h2>
      <p class="soft">A live spec site for every kind of restaurant. Open one, type your restaurant's name and pick a vibe, and see what yours could look like before we start. Nothing is saved or sent.</p>
    </div>
    <div class="spec__index">
      <ul class="spec__rows" data-reveal>
        {
          specConcepts.map((c, i) => (
            <li>
              <a class="spec__row" href={c.href} data-key={i}>
                <img class="spec__thumb" src={ogFor[c.href]} alt="" width="1200" height="630" loading="lazy" decoding="async" />
                <span class="spec__name">{c.name.replace(" / ", " and ")}</span>
                <span class="spec__note">{c.note}</span>
              </a>
            </li>
          ))
        }
      </ul>
      <div class="spec__frame" aria-hidden="true">
        {specConcepts.map((c, i) => <img class:list={["spec__pic", { "is-on": i === 0 }]} data-key={i} src={ogFor[c.href]} alt="" width="1200" height="630" loading="lazy" decoding="async" />)}
      </div>
    </div>
  </section>

  <LeadForm heading="Want yours next?" />
</Base>

<style>
  .intro { padding: clamp(3rem, 9vh, 7rem) var(--margin) 0; display: grid; gap: 2.5rem; }
  .intro h1 { max-width: 14ch; }
  .names { max-width: 48ch; font-family: var(--display); font-weight: 600; font-size: clamp(1.5rem, 1rem + 1.6vw, 2.25rem); line-height: 1.25; letter-spacing: -0.01em; }
  .names a { text-decoration: underline; text-decoration-thickness: 0.06em; color: var(--ink); }
  .names a:hover { color: var(--ember-deep); }
  .inline { display: inline-block; width: 1.6em; height: 0.9em; margin: 0 0.12em 0 0.2em; vertical-align: -0.05em; object-fit: cover; border-radius: var(--radius); transition: transform var(--t-ui) var(--ease-out); transform-origin: left center; }
  .names a:hover + .inline { transform: scale(1.6); }

  .lineage { padding: var(--section) var(--margin) 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 2rem; align-items: start; }
  .lineage h2 { grid-column: 1 / 6; max-width: 12ch; }
  .lineage__text { grid-column: 7 / 13; display: grid; gap: 1rem; font-size: var(--step-lead); line-height: 1.35; }

  .spec { padding: var(--section) var(--margin) 0; display: grid; gap: 3rem; }
  .spec__head { display: grid; gap: 1.25rem; max-width: 46rem; }
  .spec__head h2 { max-width: 14ch; }
  .spec__index { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .spec__rows { display: grid; gap: 0.25rem; }
  .spec__row { display: grid; gap: 0.35rem; padding: 1rem 0; text-decoration: none; color: var(--ink); transition: opacity var(--t-hover) ease; }
  .spec__name { font-family: var(--display); font-weight: 600; font-size: var(--step-head); line-height: 1; letter-spacing: -0.02em; }
  .spec__note { color: var(--soft); max-width: 44ch; }
  .spec__row:hover .spec__name, .spec__row:focus-visible .spec__name { color: var(--ember-deep); }
  .spec__thumb { display: none; }
  .spec__frame { position: sticky; top: 2rem; aspect-ratio: 1200 / 630; }
  .spec__pic { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius); opacity: 0; transition: opacity var(--t-ui) ease; }
  .spec__pic.is-on { opacity: 1; }
  @media (hover: hover) and (pointer: fine) {
    .spec__rows:hover .spec__row:not(:hover) { opacity: 0.4; }
  }
  @media (max-width: 560px) {
    .names { font-size: 1.375rem; }
  }
  @media (max-width: 860px), (hover: none) {
    .spec__index { grid-template-columns: 1fr; }
    .spec__frame { display: none; }
    .spec__thumb { display: block; width: 100%; aspect-ratio: 1200 / 630; object-fit: cover; border-radius: var(--radius); margin-bottom: 0.5rem; }
    .lineage h2, .lineage__text { grid-column: 1 / -1; }
  }
</style>

<script>
  const pics = document.querySelectorAll<HTMLImageElement>(".spec__pic");
  document.querySelectorAll<HTMLAnchorElement>(".spec__row").forEach((row) => {
    const show = () => pics.forEach((p) => p.classList.toggle("is-on", p.dataset.key === row.dataset.key));
    row.addEventListener("mouseenter", show);
    row.addEventListener("focus", show);
  });
</script>
