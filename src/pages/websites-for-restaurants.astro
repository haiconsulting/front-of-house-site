---
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import Faq from "../components/Faq.astro";
import Cases from "../components/Cases.astro";
import { build, carePlans, caseStudies, site } from "../data/site.ts";

const pageFaq = [
  {
    q: "What is the best website company for an independent restaurant?",
    a: `The right company depends on who will update the site, the restaurant's ordering and reservation systems, the full cost, and what the owner can take when leaving. Front of House is a fit for independent restaurants that want a custom website they own, hands-on design and support, and flat yearly care. Our builds start at ${build.from}, with Care from ${carePlans[0].price} per year, serving Park City, Salt Lake City, and metro Atlanta.`,
  },
  {
    q: "What should a restaurant website include?",
    a: "A restaurant website should make the menu, hours, location, reservations, and online ordering easy to find on a phone. It should also load quickly, reflect the restaurant's real atmosphere, and give search engines accurate information they can understand.",
  },
  {
    q: "How much does a custom restaurant website cost?",
    a: `Front of House custom restaurant websites start at ${build.from}. The final price depends on the menu, number of pages, integrations, locations, photography, video, and brand work. After launch, Care starts at ${carePlans[0].price} per year.`,
  },
  {
    q: "Does the restaurant own the website?",
    a: "Yes. Front of House clients own their website and its code outright. Every Care plan includes an exit kit, so the restaurant can leave with the complete site instead of losing a website it rented.",
  },
  {
    q: "Can you connect online ordering and reservations?",
    a: "We scope the website around the ordering, reservation, waitlist, and email tools the restaurant uses. A link or embedded booking form is different from a live POS integration. We confirm compatibility, implementation work, and any third-party charges in the proposal before building.",
  },
  {
    q: "Where does Front of House build restaurant websites?",
    a: "Front of House is currently focused on restaurants in Park City, Utah, Salt Lake City, Utah, and metro Atlanta, Georgia.",
  },
  {
    q: "Are Front of House websites built for Google and AI search?",
    a: "Yes. Every build includes a crawlable technical foundation, structured data that matches the visible page, mobile-first performance, and clear restaurant information. Those fundamentals help traditional search engines and AI-powered search systems understand the restaurant.",
  },
] as const;

const inclusions = [
  {
    title: "A menu guests can use",
    body: "Readable on a phone, searchable on the web, and structured around how people decide what to order.",
  },
  {
    title: "A direct path to the table",
    body: "Reservations, ordering, calls, and directions placed where a hungry guest expects to find them.",
  },
  {
    title: "Your restaurant, not a template",
    body: "Custom design shaped by the room, the food, and the service, with on-site photo and video when you need it.",
  },
  {
    title: "A foundation built to be found",
    body: "Fast pages, accurate metadata, structured information, and clear answers for Google and AI-powered search.",
  },
] as const;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": `${site.url}/websites-for-restaurants#webpage`,
    url: `${site.url}/websites-for-restaurants`,
    name: "Websites for Independent Restaurants",
    description:
      "Custom websites for restaurants in Park City, Salt Lake City, and metro Atlanta. Built for menus, reservations, ordering, and search. The restaurant owns the code.",
    about: { "@id": `${site.url}/#organization` },
    breadcrumb: { "@id": `${site.url}/websites-for-restaurants#breadcrumb` },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": `${site.url}/websites-for-restaurants#service`,
    name: "Custom Websites for Restaurants",
    serviceType: "Restaurant website design and development",
    provider: { "@id": `${site.url}/#organization` },
    areaServed: site.areaServed.map((area) => ({
      "@type": "Place",
      name: area,
    })),
    description:
      "Custom, mobile-first restaurant websites with menus, ordering and reservation integrations, structured data, and code ownership.",
    offers: {
      "@type": "Offer",
      priceCurrency: "USD",
      price: "2000",
      description:
        "Custom restaurant website builds start at $2,000. Final pricing is based on scope.",
      url: `${site.url}/pricing`,
      availability: "https://schema.org/InStock",
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": `${site.url}/websites-for-restaurants#breadcrumb`,
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: "Home",
        item: site.url,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: "Websites for Restaurants",
        item: `${site.url}/websites-for-restaurants`,
      },
    ],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: pageFaq.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base
  title="Websites for Independent Restaurants"
  description="Front of House builds custom websites for independent restaurants in Atlanta, Park City, and Salt Lake City. Own your code. Builds from $2,000; Care from $450/year."
  jsonLd={jsonLd}
>
  <section class="hero" aria-labelledby="wfr-title">
    <div class="hero__copy">
      <h1 id="wfr-title">Custom restaurant websites you own</h1>
      <p class="lead">
        Front of House designs and builds custom websites for independent restaurants and small groups in Park City, Salt Lake City and metro Atlanta. Your menu, reservations and ordering come first.
      </p>
      <div class="hero__actions">
        <a href="/contact" class="btn btn--primary">Talk to the team</a>
        <a href="/work" class="link">See restaurant sites</a>
      </div>
      <p class="soft">Or call {site.contact.name} at <a class="link" href={site.contact.phoneHref}>{site.contact.phone}</a>.</p>
    </div>
    <aside class="deed" aria-labelledby="deed-title" data-reveal>
      <h2 id="deed-title">Your restaurant website</h2>
      <dl class="deed__list">
        <div><dt>Owner</dt><dd>You</dd></div>
        <div><dt>Custom code</dt><dd>Included</dd></div>
        <div><dt>Monthly website rent</dt><dd class="num">$0</dd></div>
        <div><dt>Build</dt><dd class="num">From {build.from}</dd></div>
        <div><dt>Care after launch</dt><dd class="num">From {carePlans[0].price} a year</dd></div>
      </dl>
    </aside>
  </section>

  <section class="rows" aria-labelledby="fit-title">
    <h2 id="fit-title" class="rows__h">The right fit for your restaurant</h2>
    <div class="rows__body" data-reveal>
      <p>Choose Front of House if you want a custom site you own, a team to design and maintain it, and optional branding, photography and video. We start with your restaurant's current tools and confirm the scope before quoting.</p>
      <p class="soft">A self-service builder may suit an owner who wants to handle the design and updates. A restaurant platform may suit a team prioritizing built-in ordering, marketing or POS connections. Compare the full cost and exit terms alongside the design.</p>
      <p><a class="link" href="/restaurant-website-companies">Compare restaurant website companies and what to ask</a></p>
    </div>
  </section>

  <section class="shift" aria-labelledby="shift-title">
    <div class="shift__head">
      <h2 id="shift-title">Your website has a shift to work</h2>
      <p class="soft">A good restaurant website does not make guests hunt. It answers the practical questions quickly, then gives them a clear next move.</p>
    </div>
    <ul class="shift__list" data-reveal>
      {inclusions.map((item) => (
        <li>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </li>
      ))}
    </ul>
  </section>

  <figure class="quote">
    <blockquote>
      <p>&ldquo;Front of House built our sites professionally, cost-effectively, and with AI visibility in mind. Any restaurant owner paying monthly should take ownership and have a website that is truly theirs.&rdquo;</p>
    </blockquote>
    <figcaption>Co-owner of Killa and Burger Lab</figcaption>
  </figure>

  <section class="own" aria-labelledby="own-title">
    <div class="own__copy" data-reveal>
      <h2 id="own-title">A website should be an asset</h2>
      <p class="lead">Subscription platforms can keep charging long after the build is finished. We separate the thing you own from the care that keeps it current.</p>
      <p class="soft">Buy the custom website once. Keep us for hosting, maintenance and support through a flat yearly Care plan. If you leave, your site leaves with you.</p>
      <p><a class="link" href="/pricing">See full pricing and scope</a></p>
    </div>
    <div class="own__table" role="region" aria-label="Website ownership comparison" tabindex="0">
      <table>
        <thead>
          <tr><th scope="col">The question</th><th scope="col">Subscription platform</th><th scope="col" class="is-foh">Front of House</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">Who owns the code?</th><td>Check the contract</td><td class="is-foh">You do</td></tr>
          <tr><th scope="row">How do you pay?</th><td>Check recurring fees</td><td class="is-foh">Build once, care yearly</td></tr>
          <tr><th scope="row">Can you take it elsewhere?</th><td>Check export rights</td><td class="is-foh">Yes, with your full code</td></tr>
          <tr><th scope="row">Is the design yours?</th><td>Check customization limits</td><td class="is-foh">Custom to your restaurant</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <Cases />

  <section class="rows" aria-labelledby="inc-title">
    <h2 id="inc-title" class="rows__h">The whole digital front door</h2>
    <div class="rows__body" data-reveal>
      <p class="soft">We scope every build to the restaurant instead of forcing the restaurant into a package.</p>
      <dl class="incl">
        <div><dt>Menu</dt><dd>Readable HTML pages, not a hard-to-use PDF alone</dd></div>
        <div><dt>Guest actions</dt><dd>Reservations, ordering, calls and directions</dd></div>
        <div><dt>Mobile</dt><dd>Thumb-ready layouts and fast-loading pages</dd></div>
        <div><dt>Search</dt><dd>Metadata, structured data, a sitemap and crawl access</dd></div>
        <div><dt>Brand</dt><dd>Custom visual direction, with identity work if needed</dd></div>
        <div><dt>Content</dt><dd>On-site restaurant photography and video when scoped</dd></div>
        <div><dt>Care</dt><dd>Hosting, maintenance, backups and hands-on changes</dd></div>
        <div><dt>Ownership</dt><dd>Your code, and an exit kit if you ever leave</dd></div>
      </dl>
    </div>
  </section>

  <figure class="quote quote--light">
    <blockquote>
      <p>&ldquo;The website their team built for me was excellent, and the customer service is quick and helpful. I have complete control and ownership of my site.&rdquo;</p>
    </blockquote>
    <figcaption>Owner, Dasks Greek Grill</figcaption>
  </figure>

  <Faq heading="Questions about restaurant websites" items={pageFaq} />
  <LeadForm heading="Own your website" />
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 3rem;
    align-items: end;
    padding: clamp(3rem, 9vh, 7rem) var(--margin) 0;
  }
  .hero__copy { grid-column: 1 / 8; display: grid; gap: 1.5rem; justify-items: start; }
  .hero__copy h1 { max-width: 16ch; }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.75rem; font-weight: 600; }
  .deed { grid-column: 9 / 13; display: grid; gap: 1.5rem; padding: clamp(1.5rem, 3vw, 2.25rem); background: var(--ink); color: var(--paper); border-radius: var(--radius); }
  .deed h2 { font-size: var(--step-lead); font-family: var(--display); font-size: clamp(1.75rem, 1.2rem + 1.6vw, 2.5rem); color: var(--paper); }
  .deed__list { display: grid; gap: 0.75rem; margin: 0; }
  .deed__list div { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; }
  .deed__list dt { color: var(--muted-on-ink); }
  .deed__list dd { margin: 0; font-weight: 600; text-align: right; }

  .rows { padding: var(--section) var(--margin) 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 2rem; }
  .rows__h { grid-column: 1 / 5; max-width: 14ch; font-size: clamp(2rem, 1.3rem + 2.2vw, 3.25rem); }
  .rows__body { grid-column: 6 / 13; display: grid; gap: 1rem; max-width: 64ch; }

  .shift { margin-top: var(--section); padding: clamp(3.5rem, 7vw, 6rem) var(--margin); background: var(--surface); display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 3rem; }
  .shift__head { grid-column: 1 / 6; display: grid; gap: 1.25rem; align-content: start; }
  .shift__head h2 { max-width: 17ch; }
  .shift__list { grid-column: 7 / 13; display: grid; gap: 2rem; }
  .shift__list h3 { font-family: var(--display); font-weight: 600; font-size: var(--step-lead); letter-spacing: -0.01em; }
  .shift__list p { margin-top: 0.35rem; color: var(--soft); }

  .quote { margin: var(--section) 0 0; padding: clamp(3.5rem, 8vw, 7rem) var(--margin); background: var(--dusk); color: var(--paper); display: grid; gap: 1.5rem; }
  .quote blockquote { margin: 0; }
  .quote blockquote p { max-width: 44ch; font-family: var(--display); font-weight: 500; font-size: var(--step-lead); line-height: 1.3; }
  .quote figcaption { color: var(--muted-on-ink); }
  .quote--light { background: var(--toast); color: var(--ink); }
  .quote--light figcaption { color: var(--soft); }

  .own { padding: var(--section) var(--margin) 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 2.5rem; align-items: start; }
  .own__copy { grid-column: 1 / 6; display: grid; gap: 1.25rem; }
  .own__copy h2 { max-width: 17ch; }
  .own__table { grid-column: 7 / 13; overflow-x: auto; }
  .own__table table { width: 100%; border-collapse: collapse; }
  .own__table th, .own__table td { text-align: left; padding: 0.9rem 0.75rem; border-bottom: 1px solid var(--line); vertical-align: top; }
  .own__table thead th { font-weight: 600; }
  .own__table tbody th { font-weight: 500; color: var(--soft); }
  .own__table .is-foh { background: var(--surface); font-weight: 600; }

  .incl { margin: 1rem 0 0; display: grid; gap: 0.9rem; }
  .incl div { display: grid; grid-template-columns: 9rem minmax(0, 1fr); gap: 1rem; }
  .incl dt { font-weight: 600; color: var(--ink); }
  .incl dd { margin: 0; color: var(--soft); }

  @media (max-width: 860px) {
    .hero__copy, .deed, .rows__h, .rows__body, .shift__head, .shift__list, .own__copy, .own__table { grid-column: 1 / -1; }
    .incl div { grid-template-columns: 1fr; gap: 0.15rem; }
  }
</style>
