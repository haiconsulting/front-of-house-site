---
// Services. Each service is a statement on the left and its proof on the right, core first.
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import Faq from "../components/Faq.astro";
import { site, faq, carePlans, build } from "../data/site.ts";

const services = [
  {
    name: "Build",
    when: "With every partnership",
    line: "A real, custom website you own.",
    body: `Hand-built, fast and made to turn visitors into covers. Real code you own outright from ${build.from}, not a drag-and-drop template you rent forever. Readable menus, clear hours and structured data so search engines and AI assistants can understand it.`,
    points: "Custom code you own, mobile first and accessible, built for AI search.",
    v: "burger-lab",
    alt: "Burger Lab's site, built by Front of House",
  },
  {
    name: "Care",
    when: "With every partnership",
    line: "We keep you running.",
    body: `Hosting and maintenance for one flat ${carePlans[0].price} a year, with no monthly rent. Edit it yourself or text the Host, your front-of-house AI. Either way it gets done, and our team checks every change before it goes live.`,
    points: "Hosting included, changes reviewed, your exit kit always ready.",
    v: "killa-nikkei",
    alt: "Killa's site, kept current under Care",
  },
  {
    name: "Brand and design",
    when: "When you need a look",
    line: "A look, not just a site.",
    body: "Identity, menu and a visual system for restaurants that need a real brand. Logo, type, colour and the menu design that ties it together, built to read as well on the table as on the screen.",
    points: "Logo and identity, menu design, colour, type and art direction.",
    v: "dasks",
    alt: "Dasks Greek Grill's site and identity",
  },
  {
    name: "Capture",
    when: "When you need pictures",
    line: "The room, the plates, the people.",
    body: "On-site photo and video, shot where you serve. We capture the space, the food and the team, then edit and deliver a library your site and socials can pull from all year.",
    points: "On-location photo and video, food and interior styling, edited and delivered.",
    v: "killa-film",
    alt: "Killa's dining room and plates, from the film on its home page",
  },
];

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    provider: { "@id": `${site.url}/#organization` },
    name: "Restaurant Website Design and Build",
    description:
      "Custom restaurant website the owner owns outright. Hand-built, fast, mobile-first, accessible, optimized for AI search. One-time build from $2,000.",
    serviceType: "Website Design",
    areaServed: "United States",
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Restaurant Web Studio Services",
      itemListElement: services.map((s) => ({
        "@type": "Offer",
        itemOffered: { "@type": "Service", name: s.name, description: s.body },
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.services.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base
  title="Services"
  description="Front of House builds custom restaurant websites you own, keeps them hosted and current for a flat yearly fee, and adds branding and on-site photo and video when you need them."
  jsonLd={jsonLd}
>
  <section class="intro" aria-labelledby="svc-title">
    <h1 id="svc-title">What a restaurant web studio does</h1>
    <p class="lead" data-reveal>
      <span>Four services around one idea: your website is your new front of house. Building it and caring for it come with every partnership. Brand and on-site capture are there when you need them.</span>
    </p>
  </section>

  <div class="svcs">
    {
      services.map((s, i) => (
        <section class={`svc svc--${i}`} aria-labelledby={`svc-${i}`}>
          <div class="svc__text" data-reveal>
            <h2 id={`svc-${i}`}>{s.name}</h2>
            <p class="svc__when">{s.when}</p>
            <p class="svc__line">{s.line}</p>
            <p class="svc__body">{s.body}</p>
            <p class="svc__points">{s.points}</p>
          </div>
          <div class="svc__proof">
            <video muted loop playsinline preload="none" poster={`/videos/${s.v}.jpg`} aria-label={s.alt} data-autoplay>
              <source src={`/videos/${s.v}.mp4`} type="video/mp4" />
              <source src={`/videos/${s.v}.webm`} type="video/webm" />
            </video>
          </div>
        </section>
      ))
    }
  </div>

  <section class="steps" aria-labelledby="steps-title">
    <h2 id="steps-title" class="visually-hidden">How it works</h2>
    <ol class="steps__list" data-reveal>
      <li class="step step--0"><h3 class="step__line">First, we talk.</h3><p class="step__text">About your menu, your photos and what the site has to do. You leave with a scope and a price.</p></li>
      <li class="step step--1"><h3 class="step__line">Then we build it.</h3><p class="step__text">Designed and coded for your restaurant, shot on site if you want it.</p></li>
      <li class="step step--2"><h3 class="step__line">You own it. We keep it sharp.</h3><p class="step__text">Go live, then a flat yearly Care fee keeps it hosted, current and yours.</p></li>
    </ol>
  </section>

  <Faq heading="Questions about our services" items={faq.services} />
  <LeadForm heading="Tell us what your restaurant needs" />
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 2rem;
    align-items: end;
    padding: clamp(3rem, 9vh, 7rem) var(--margin) 0;
  }
  .intro h1 { grid-column: 1 / 9; max-width: 18ch; }
  .intro .lead { grid-column: 9 / 13; max-width: 36ch; }
  .intro .lead span { display: block; }

  .svcs { padding-top: var(--section); display: grid; gap: clamp(6rem, 10vw, 9rem); }
  .svc { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 2rem; padding-inline: var(--margin); align-items: center; }
  .svc__text { grid-column: 1 / 6; display: grid; gap: 0.9rem; align-content: start; }
  .svc__when { color: var(--soft); }
  .svc__line { font-size: var(--step-lead); line-height: 1.3; color: var(--ink); margin-top: 0.5rem; }
  .svc__body { color: var(--soft); }
  .svc__points { font-weight: 600; color: var(--ink); }
  .svc__proof { grid-column: 7 / 13; }
  .svc__proof video { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; border-radius: var(--radius); background: var(--dusk); }
  /* Neighbours never share a layout: the optional services turn the split around and sit on a tone step. */
  .svc--2, .svc--3 { background: var(--surface); padding-block: clamp(3rem, 6vw, 5rem); }
  .svc--2 .svc__text, .svc--3 .svc__text { grid-column: 8 / 13; grid-row: 1; }
  .svc--2 .svc__proof, .svc--3 .svc__proof { grid-column: 1 / 7; grid-row: 1; }
  .svc--1 .svc__proof { grid-column: 6 / 13; }

  .svc--3 { margin-top: calc(-1 * clamp(6rem, 10vw, 9rem)); background: var(--toast); }

  .steps { padding: var(--section) var(--margin) 0; }
  .steps__list { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 3.5rem; }
  .step { grid-column: 1 / -1; }
  .step--1 { grid-column-start: 3; }
  .step--2 { grid-column-start: 5; }
  .step__line { font-family: var(--display); font-weight: 600; font-size: var(--step-head); letter-spacing: -0.025em; line-height: 1; }
  .step--2 .step__line { color: var(--ember-deep); }
  .step__text { margin-top: 0.75rem; max-width: 36ch; color: var(--soft); }
  @media (min-width: 1100px) {
    .steps__list { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 0; align-items: start; }
    .step, .step--1, .step--2 { grid-column: auto; }
    .step--1 { margin-top: 3.5rem; }
    .step--2 { margin-top: 7rem; }
    .step__line { font-size: clamp(2rem, 0.9rem + 1.7vw, 2.75rem); }
  }

  @media (max-width: 860px) {
    .intro h1, .intro .lead { grid-column: 1 / -1; }
    .svc__text, .svc__proof,
    .svc--1 .svc__proof,
    .svc--2 .svc__text, .svc--3 .svc__text, .svc--2 .svc__proof, .svc--3 .svc__proof { grid-column: 1 / -1; grid-row: auto; }
    .svc__proof { order: -1; }
    .steps__list { grid-template-columns: 1fr; row-gap: 2.5rem; }
    .step { grid-column: 1; }
    .step--1 { padding-left: 6vw; }
    .step--2 { padding-left: 12vw; }
  }
</style>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  const io = new IntersectionObserver(
    (entries) => entries.forEach((e) => {
      const v = e.target as HTMLVideoElement;
      if (e.isIntersecting && !reduce) { v.preload = "auto"; v.play().catch(() => {}); } else v.pause();
    }),
    { threshold: 0.25 },
  );
  document.querySelectorAll<HTMLVideoElement>(".svc video[data-autoplay]").forEach((v) => io.observe(v));
</script>
