---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { Image } from "astro:assets";
import burgerPreview from "../../public/videos/burger-lab.jpg";
import { steps, site, faq, build, carePlans } from "../data/site.ts";

const services = [
  {
    id: "websites",
    name: "The website.",
    label: "The main course",
    kind: "Core",
    line: "Your restaurant, beautifully translated.",
    body: "A custom website that gives people a feel for your place and a clear next step. Explore the menu. Book a table. Place an order. Every detail works together, on a phone in someone’s hand or a screen at home.",
    points: [
      "Custom design and code you own",
      "Readable menus, reservations & ordering links",
      "Mobile-first design & search foundations",
    ],
    note: `One-time builds from ${build.from}`,
  },
  {
    id: "brand",
    name: "The identity.",
    label: "Make your mark",
    kind: "Optional",
    line: "A look that belongs to your place.",
    body: "From the sign out front to the menu on the table, the best restaurant brands feel like themselves everywhere. We build a visual identity with enough character to be remembered, and enough consistency to grow with you.",
    points: [
      "Logo & identity system",
      "Color, typography & art direction",
      "Menu design & layout",
    ],
    note: "Scoped around your restaurant",
  },
  {
    id: "capture",
    name: "The atmosphere.",
    label: "Show what makes you",
    kind: "Optional",
    line: "The space. The plates. The people.",
    body: "The light in your dining room. The last touch on a dish. The people who make the place. Our on-site photography and video capture the details guests come for, with a library you can use across your website and socials.",
    points: [
      "On-location photo & video",
      "Food, interiors & team",
      "Edited assets, ready to use",
    ],
    note: "On-site capture, scoped separately",
  },
  {
    id: "care",
    name: "The ongoing care.",
    label: "Still here after launch",
    kind: "Core",
    line: "You run the restaurant. We keep it current.",
    body: "Your hours change. The seasonal menu arrives. A new photo deserves the spotlight. Edit it yourself, ask our team, or ask the Host, your front-of-house AI. The Host drafts changes, our team checks them, and your site stays in step.",
    points: [
      "Hosting, security & maintenance",
      "The Host AI assistant & team support",
      "Your full code, whenever you need it",
    ],
    note: `Care from ${carePlans[0].price} / year`,
  },
];
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "Service",
    provider: { "@id": `${site.url}/#organization` },
    name: "Restaurant Website Design and Build",
    description:
      "Custom restaurant websites, brand identity, photography and video, and annual care. One-time website builds from $2,000.",
    serviceType: "Website Design",
    areaServed: "United States",
    hasOfferCatalog: {
      "@type": "OfferCatalog",
      name: "Restaurant Web Studio Services",
      itemListElement: services.map((service) => ({
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: service.name,
          description: service.body,
        },
      })),
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faq.services.map((item) => ({
      "@type": "Question",
      name: item.q,
      acceptedAnswer: { "@type": "Answer", text: item.a },
    })),
  },
];
---

<Base
  title="Services"
  description="Custom restaurant websites, distinctive brands, on-site photo and video, and ongoing care. Website builds from $2,000. You own the code."
  jsonLd={jsonLd}
>
  <section class="services-hero" data-od-id="services-introduction">
    <div class="container">
      <p class="kicker">A full-service welcome</p>
      <div class="hero-grid">
        <h1>
          Everything
          <br /> before the
          <br /> <span>first bite.</span>
        </h1>
        <div class="hero-copy">
          <p>
            A website that feels like your restaurant. A brand people remember.
            The photos that make them hungry.
          </p>
          <p>We bring it all to the table, then stay to keep it working.</p>
          <a class="btn btn--primary" href="/contact">
            Tell us about your restaurant <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <nav class="service-nav" aria-label="Our services">
        {services.map((service, i) => (
          <a href={`#${service.id}`}>
            <span>0{i + 1}</span>
            {service.name}
            <span aria-hidden="true">↓</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="offerings-section" id="offerings" data-od-id="services-menu">
    <div class="container">
      {services.map((service, i) => (
        <article class="service" id={service.id}>
          <div class="service-title">
            <p class="kicker">
              <span>0{i + 1}</span> / {service.label}
            </p>
            <h2>{service.name}</h2>
            <span class="service-kind">
              {service.kind === "Core"
                ? "Part of every partnership"
                : "Add it when you need it"}
            </span>
          </div>
          <div class="service-content">
            <h3>{service.line}</h3>
            <p>{service.body}</p>
            <ul>
              {service.points.map((point) => (
                <li>
                  <span aria-hidden="true">↗</span>
                  {point}
                </li>
              ))}
            </ul>
            <p class="service-note">{service.note}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="in-practice" data-od-id="services-in-practice">
    <div class="container practice-grid">
      <div class="practice-copy">
        <p class="kicker">From the menu to the screen</p>
        <h2>
          Every place has
          <br /> a personality.
          <br /> Let’s show yours.
        </h2>
        <p>
          For Burger Lab, that means a bold visual world with its menu, online
          ordering, and waitlist built into the experience.
        </p>
        <a href="/work">
          See the work <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="practice-media">
        <Image
          src={burgerPreview}
          alt="Burger Lab's custom restaurant website with its menu and ordering experience"
          widths={[480, 800, 1280]}
          sizes="(max-width: 850px) 100vw, 55vw"
          loading="lazy"
        />
        <span class="practice-caption">BURGER.LAB / Salt Lake City, UT</span>
      </div>
    </div>
  </section>

  <section class="process-section" id="how" data-od-id="services-process">
    <div class="container">
      <div class="section-heading">
        <p class="kicker">From first hello to opening day</p>
        <h2>We keep this simple.</h2>
      </div>
      <div class="steps">
        {steps.map((step) => (
          <article class="step">
            <span class="step-number">0{step.n}</span>
            <h3>{step.title}</h3>
            <p>{step.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="questions-section" id="faq" data-od-id="services-questions">
    <div class="container questions-grid">
      <div>
        <p class="kicker">Good questions</p>
        <h2>
          Let’s clear
          <br /> a few things up.
        </h2>
        <p class="questions-note">
          For the full breakdown of what a build costs and what Care includes,{" "}
          <a href="/pricing">
            take a look at our pricing <span aria-hidden="true">↗</span>
          </a>
          .
        </p>
      </div>
      <div class="faq-list">
        {faq.services.map((item) => (
          <details class="faq-item">
            <summary>
              {item.q}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>

<style>
  .services-hero {
    padding-block: clamp(3.5rem, 7vw, 6rem) 0;
  }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    gap: clamp(2rem, 7vw, 7rem);
    align-items: end;
    margin-top: 2rem;
  }
  h1 {
    font-size: clamp(4rem, 8.4vw, 8rem);
    letter-spacing: -0.065em;
    line-height: 0.96;
    font-weight: 550;
    margin: 0;
  }
  h1 > span {
    color: var(--ember);
  }
  .hero-copy {
    padding-bottom: 0.25rem;
  }
  .hero-copy > p {
    font-size: clamp(1.05rem, 1.7vw, 1.35rem);
    line-height: 1.6;
    max-width: 29ch;
  }
  .hero-copy > p + p {
    font-size: 1rem;
    max-width: 34ch;
    margin-bottom: 2rem;
  }
  .hero-copy .btn {
    font-size: 0.78rem;
    white-space: normal;
    gap: 1.5rem;
  }
  .service-nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: clamp(3.5rem, 7vw, 6rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .service-nav a {
    display: flex;
    align-items: center;
    padding-block: 1.4rem;
    gap: 0.75rem;
    font-size: 0.83rem;
    font-weight: 550;
    color: var(--ink);
  }
  .service-nav a > span:first-child {
    color: var(--muted);
    font-size: 0.65rem;
    font-weight: 400;
  }
  .service-nav a > span:last-child {
    margin-left: auto;
    margin-right: 1.5rem;
    color: var(--ember);
  }
  .service-nav a:hover {
    color: var(--ember);
  }
  .offerings-section {
    padding-block: clamp(1rem, 3vw, 3rem) clamp(3rem, 6vw, 5rem);
  }
  .service {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 8vw, 8rem);
    padding-block: clamp(3.5rem, 6.5vw, 6rem);
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 5rem;
  }
  .service:last-child {
    border-bottom: 0;
    padding-bottom: 1rem;
  }
  .service-title .kicker {
    font-size: 0.66rem;
    margin-bottom: 1.5rem;
  }
  .service-title h2 {
    font-size: clamp(2.5rem, 4.5vw, 4.25rem);
    font-weight: 550;
    letter-spacing: -0.055em;
    line-height: 1.07;
    margin-bottom: 1.2rem;
    max-width: 11ch;
  }
  .service-kind {
    font-size: 0.74rem;
    color: var(--muted);
  }
  .service-content h3 {
    font-size: 1.35rem;
    font-weight: 550;
    line-height: 1.3;
    letter-spacing: -0.035em;
    margin-bottom: 1rem;
  }
  .service-content > p {
    font-size: 1rem;
    line-height: 1.7;
    max-width: 54ch;
  }
  .service-content ul {
    list-style: none;
    margin: 1.7rem 0 1.5rem;
    padding: 0;
  }
  .service-content li {
    display: flex;
    gap: 1rem;
    padding-block: 0.45rem;
    font-size: 0.88rem;
    color: var(--ink);
    align-items: baseline;
  }
  .service-content li > span {
    color: var(--ember);
  }
  .service-content .service-note {
    display: inline-block;
    color: var(--ember);
    font-size: 0.75rem;
    font-weight: 550;
    padding-top: 0.6rem;
    margin: 0;
  }
  .in-practice {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(4rem, 7.5vw, 7rem);
  }
  .practice-grid {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: center;
  }
  .practice-copy .kicker {
    color: var(--paper);
  }
  .practice-copy h2 {
    color: var(--paper);
    font-size: clamp(2.5rem, 4vw, 3.8rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    margin-block: 1.7rem;
    line-height: 1.08;
  }
  .practice-copy > p:not(.kicker) {
    font-size: 1rem;
    color: var(--paper);
    max-width: 39ch;
  }
  .practice-copy a {
    display: inline-flex;
    align-items: center;
    gap: 3rem;
    color: var(--paper);
    border-bottom: 1px solid var(--paper);
    padding-block: 0.75rem;
    margin-top: 0.5rem;
    font-size: 0.85rem;
  }
  .practice-copy a:focus-visible {
    outline-color: var(--paper);
  }
  .practice-media {
    min-width: 0;
  }
  .practice-media :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 16/9;
    border-radius: 0;
    object-fit: cover;
  }
  .practice-caption {
    display: block;
    margin-top: 1rem;
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .process-section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .section-heading h2 {
    font-size: clamp(2.5rem, 4vw, 3.8rem);
    font-weight: 550;
    letter-spacing: -0.05em;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
    margin-top: 3rem;
  }
  .step {
    border-top: 1px solid var(--line);
    padding-top: 1.5rem;
  }
  .step-number {
    display: block;
    font-family: var(--display);
    font-size: 3.2rem;
    line-height: 1;
    letter-spacing: -0.06em;
    font-weight: 500;
    color: var(--ember);
    margin-bottom: 2.5rem;
  }
  .step h3 {
    font-size: 1.35rem;
    letter-spacing: -0.035em;
    font-weight: 550;
    line-height: 1.25;
  }
  .step p {
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 1rem 0 0;
    max-width: 34ch;
  }
  .questions-section {
    padding-block: clamp(4rem, 7vw, 6rem);
    background: var(--bone);
  }
  .questions-grid {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .questions-grid h2 {
    font-size: clamp(2.1rem, 3.3vw, 3.25rem);
    letter-spacing: -0.05em;
    font-weight: 550;
    line-height: 1.1;
  }
  .questions-note {
    max-width: 34ch;
    font-size: 0.94rem;
    margin-top: 1.5rem;
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
  }
  .faq-item:first-child {
    border-top: 1px solid var(--line);
  }
  .faq-item summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.4rem;
    color: var(--ink);
    font-weight: 550;
    font-size: 0.98rem;
    line-height: 1.5;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary > span {
    color: var(--ember);
    font-size: 1.5rem;
    flex: none;
    font-weight: 400;
  }
  .faq-item[open] summary > span {
    transform: rotate(45deg);
  }
  .faq-item > p {
    padding-bottom: 1.4rem;
    font-size: 0.94rem;
    line-height: 1.7;
    max-width: 62ch;
    margin: 0;
  }
  @media (max-width: 850px) {
    .hero-grid {
      grid-template-columns: 1.15fr 0.85fr;
      gap: 2rem;
    }
    .hero-copy .btn {
      padding-inline: 1rem;
    }
    .service-nav {
      grid-template-columns: repeat(2, 1fr);
    }
    .service-nav a:nth-child(-n + 2) {
      border-bottom: 1px solid var(--line);
    }
    .service {
      gap: 2rem;
    }
    .practice-grid {
      grid-template-columns: 1fr;
    }
    .practice-copy > p:not(.kicker) {
      max-width: 50ch;
    }
    .practice-media :global(img) {
      aspect-ratio: 16/9;
    }
    .steps {
      gap: 1.5rem;
    }
    .questions-grid {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 600px) {
    .hero-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    h1 {
      font-size: clamp(4rem, 14vw, 5.5rem);
    }
    .hero-copy > p {
      max-width: 36ch;
    }
    .hero-copy > p + p {
      max-width: 36ch;
    }
    .hero-copy .btn {
      font-size: 0.86rem;
    }
    .service-nav a {
      font-size: 0.75rem;
    }
    .service-nav a > span:last-child {
      margin-right: 0.8rem;
    }
    .service {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .service-title h2 {
      max-width: none;
      font-size: 2.8rem;
    }
    .service-title .kicker {
      margin-bottom: 1rem;
    }
    .service-content li {
      font-size: 1rem;
    }
    .service-content .service-note {
      font-size: 0.85rem;
    }
    .steps {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    .step-number {
      font-size: 2.5rem;
      margin-bottom: 1.5rem;
    }
    .step p,
    .faq-item > p,
    .questions-note {
      font-size: 1rem;
    }
  }
</style>
