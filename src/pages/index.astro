---
// Home. Taste Skill v2, direction "The sentence is the layout" (seed 541284264), brand palette and type kept.
// The idea: FOH's promise, "Own it. Don't rent it.", is split by a frame, and a reel of restaurant sites
// we built passes through the gap. The reader finishes the sentence with their eyes: own *this*.
// The live thing: the rent-versus-own ledger, recalculated from the visitor's own monthly fee.
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import Cases from "../components/Cases.astro";
import Faq from "../components/Faq.astro";
import { site, faq, carePlans, build, cta } from "../data/site.ts";

const reel = [
  { v: "killa-nikkei-hero", name: "Killa", place: "Nikkei, Salt Lake City" },
  { v: "burger-lab", name: "Burger Lab", place: "Burgers and cocktails, Salt Lake City" },
  { v: "dasks", name: "Dasks Greek Grill", place: "Greek grill, Salt Lake City" },
  { v: "killa-nikkei", name: "Killa", place: "Reservations and menu" },
];

const steps = [
  { line: "First, we talk.", text: "Twenty minutes about your menu, your photos and what the site has to do. You leave with a scope and a price." },
  { line: "Then we build it.", text: "Designed and coded for your restaurant, with photos and video shot on site if you want them." },
  { line: "You own it.", text: "Your code, your domain and an exit kit. Leave whenever you like and take the whole site with you." },
  { line: "We keep it sharp.", text: `Hosting, fixes and changes for ${carePlans[0].price} a year. Text the Host, our AI, to change a price, and we check it before it goes live.` },
];

const questions = [
  faq.pricing[0],
  faq.pricing[1],
  {
    q: "Do I really own it? What if you disappear?",
    a: "Yes, you own it. Every client gets an exit kit: the full code, documented and ready to run anywhere. If we vanished tomorrow, any developer could keep your site running. The platforms don't offer that. We build it this way on purpose.",
  },
  {
    q: "We just redid our website last year. Is this for us?",
    a: "Maybe. The question is less how old it is and more whether you own it. If you pay a platform every month, you are still renting. If your site is solid and you only need it kept up, we can talk about Care on its own and tell you honestly what makes sense.",
  },
  {
    q: "I don't have time to manage a website.",
    a: "You won't have to. Text the Host to update your hours or swap a photo, our team checks the change, and it goes live. For anything bigger you call or email a person who knows your restaurant. No tickets.",
  },
  faq.services[3],
];

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};

// Ledger defaults (also the no-script state): $300 a month for 3 years.
const fee = 300, years = 3, buildFrom = 2000, care = 450;
const rent = fee * 12 * years;
const own = buildFrom + care * years;
const fmt = (n: number) => n.toLocaleString("en-US");
---

<Base
  title="Restaurant websites you own"
  description="Front of House designs, builds and runs custom websites for restaurants. Pay once from $2,000, own the code, and keep it sharp for $450 a year, with no monthly rent. Park City, Salt Lake City and Atlanta."
  jsonLd={faqLd}
>
  <!-- Hero: the promise, split by a reel of sites we built -->
  <section class="stage" aria-labelledby="hero-title" data-reel-count={reel.length}>
    <div class="stage__pin">
      <div class="stage__hero">
        <h1 id="hero-title" class="stage__sentence">
          <span class="half half--a">Own it.</span>
          <span class="half half--b">Don&rsquo;t rent it.</span>
        </h1>
        <div class="reel" aria-label="Restaurant websites built by Front of House">
          <div class="reel__track">
            {
              reel.map((r, i) => (
                <figure class="reel__frame" data-i={i}>
                  <video
                    muted
                    loop
                    playsinline
                    preload={i === 0 ? "auto" : "none"}
                    poster={`/videos/${r.v}.jpg`}
                    aria-hidden="true"
                    {...(i === 0 ? { autoplay: true } : {})}
                  >
                    <source src={`/videos/${r.v}.webm`} type="video/webm" />
                    <source src={`/videos/${r.v}.mp4`} type="video/mp4" />
                  </video>
                  <figcaption class="small"><strong>{r.name}</strong>, {r.place}</figcaption>
                </figure>
              ))
            }
          </div>
        </div>
        <div class="stage__foot">
          <p class="stage__lede">
            {site.name} designs, builds and runs websites for restaurants. You pay once, you own the code, and we keep it sharp for {carePlans[0].price} a year.
          </p>
          <a href="#talk" class="btn btn--primary stage__go">{cta.label}</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Work: one block per restaurant -->
  <Cases>
    <p class="work__more">
      Three restaurants, all in Salt Lake City, all owned by the people who run them.
      <a class="link" href="/templates">See your own restaurant on a live template</a> in about a minute.
    </p>
  </Cases>

  <!-- The one centred moment on the page: an owner, in their own words. -->
  <figure class="voice" data-reveal>
    <blockquote><p>&ldquo;Any restaurant owner paying monthly should take ownership and have a website that is truly theirs.&rdquo;</p></blockquote>
    <figcaption>Co-owner of Killa and Burger Lab</figcaption>
  </figure>

  <!-- The ledger: the live thing -->
  <section class="ledger" aria-labelledby="ledger-title">
    <div class="ledger__left" data-reveal>
      <h2 id="ledger-title"><span class="ledger__soft">Renting adds up.</span> <span>Owning doesn&rsquo;t.</span></h2>
      <form class="calc" aria-label="Your numbers" onsubmit="return false">
        <label for="calc-fee">What your platform charges each month</label>
        <div class="calc__row">
          <input id="calc-fee" type="range" min="100" max="600" step="25" value={fee} />
          <output for="calc-fee" class="num" id="calc-fee-out">${fee}</output>
        </div>
        <label for="calc-years">How many years you stay on it</label>
        <div class="calc__row">
          <input id="calc-years" type="range" min="1" max="5" step="1" value={years} />
          <output for="calc-years" class="num" id="calc-years-out">{years} years</output>
        </div>
      </form>
    </div>
    <dl class="ledger__figures num" aria-live="polite">
      <div class="fig">
        <dt class="fig__n" id="fig-rent">{fmt(rent)}</dt>
        <dd class="fig__cap" id="cap-rent">dollars renting a platform at ${fee} a month for {years} years, and you own none of it</dd>
      </div>
      <div class="fig">
        <dt class="fig__n" id="fig-own">{fmt(own)}</dt>
        <dd class="fig__cap" id="cap-own">dollars with us over the same {years} years: a build from {build.from} plus Care at {carePlans[0].price} a year</dd>
      </div>
      <div class="fig fig--accent">
        <dt class="fig__n" id="fig-diff">{fmt(rent - own)}</dt>
        <dd class="fig__cap" id="cap-diff">dollars that stay in your restaurant</dd>
      </div>
      <div class="fig">
        <dt class="fig__n">100</dt>
        <dd class="fig__cap">percent of the code you own with us, exit kit included</dd>
      </div>
    </dl>
    <p class="ledger__note small soft">
      An illustration, not a competitor quote. Builds run from {build.from} and are priced to your restaurant; domain, third-party tools and out-of-scope work are separate. <a class="link" href="/pricing">See pricing</a>
    </p>
  </section>

  <!-- How it works: lines that step across -->
  <section class="steps" aria-labelledby="steps-title">
    <h2 id="steps-title" class="visually-hidden">How it works</h2>
    <ol class="steps__list" data-reveal>
      {
        steps.map((s, i) => (
          <li class={`step step--${i}`}>
            <h3 class="step__line">{s.line}</h3>
            <p class="step__text">{s.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <!-- About: the team, with a picture as a drop cap -->
  <section class="who" aria-label="Who we are">
    <ul class="who__facts small" data-reveal>
      <li>Park City and Salt Lake City, Utah, and metro Atlanta</li>
      <li>Founded in {site.foundingYear}</li>
      <li><a class="link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a></li>
    </ul>
    <div class="who__text" data-reveal>
      <p class="who__p">
        <img class="who__pic" src="/work/killa-aerial-square.jpg" width="720" height="720" alt="Downtown Salt Lake City at dusk, with Killa's lit windows in the foreground" loading="lazy" decoding="async" />
        <strong>{site.name}</strong> is six people. Two of us have run restaurants, worked the Friday rush and closed out the night. Four of us are the builders from HAI who made the sites for Killa and Burger Lab. We work only with independent restaurants and small groups, and we stay after launch.
      </p>
      <p class="who__p soft">
        No retainers and no support tickets. When something needs to change, you text the Host or call us, and a person who knows your restaurant makes sure it&rsquo;s right. <a class="link" href="/about">More about us</a>
      </p>
    </div>
  </section>

  <LeadForm />

  <!-- FAQ: wide heading, indented questions -->
  <Faq heading="What owners ask us" items={questions} />
</Base>

<style>
  /* ---------- hero: the sentence split by the reel ----------
     "Own it." top left, a window in the middle where the reel of sites we built slides past,
     "Don't rent it." bottom right with the supporting sentence beside it. Above 1024px the stage
     pins while the reel advances one site per stretch of scroll; below that it is static. */
  .stage {
    --hero-size: clamp(3.25rem, 0.8rem + 5.4vw, 7.5rem);
    /* The frame fills the step between the end of "Own it." (about 2.8em) and the start of
       "Don't rent it." (about 4.65em), and never grows taller than the screen allows. */
    --frame-w: min(56vw, calc((100svh - 27rem) * 1.7778), calc(100vw - 2 * var(--margin) - var(--hero-size) * 7.45 - 3rem));
    --frame-h: calc(var(--frame-w) * 0.5625);
    --fig-h: calc(var(--frame-h) + 2.25rem);
    --gap: 1rem;
    --sliver: 2rem;
    --pitch: calc(var(--fig-h) + var(--gap));
    --slot-h: calc(var(--fig-h) + 2 * var(--sliver));
    position: relative;
  }
  .stage__pin {
    position: relative;
    display: grid;
    grid-template-rows: minmax(1.25rem, 0.45fr) auto 1fr;
    min-height: calc(100svh - 4.5rem);
    padding: 1.25rem var(--margin);
    overflow: hidden;
  }
  .stage__hero {
    grid-row: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto var(--slot-h) auto;
    row-gap: 0.75rem;
  }
  .stage__sentence {
    grid-area: 1 / 1 / 4 / 2;
    display: grid;
    grid-template-rows: auto var(--slot-h) auto;
    row-gap: 0.75rem;
    margin: 0;
    pointer-events: none;
  }
  .half {
    font-size: var(--hero-size);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 0.95;
    white-space: nowrap;
    color: var(--ink);
  }
  .half--a { grid-row: 1; justify-self: start; }
  .half--b { grid-row: 3; justify-self: end; align-self: end; }
  .reel {
    grid-area: 2 / 1 / 3 / 2;
    justify-self: start;
    margin-left: calc(var(--hero-size) * 2.8 + 1.5rem);
    position: relative;
    width: var(--frame-w);
    height: var(--slot-h);
    overflow: hidden;
  }
  .reel__track {
    position: absolute;
    inset: 0;
    transform: translateY(calc(var(--p, 0) * var(--pitch) * -1));
    will-change: transform;
  }
  .reel__frame {
    position: absolute;
    left: 0;
    right: 0;
    top: calc(var(--sliver) + var(--i) * var(--pitch));
    margin: 0;
  }
  .reel__frame:nth-child(1) { --i: 0; }
  .reel__frame:nth-child(2) { --i: 1; }
  .reel__frame:nth-child(3) { --i: 2; }
  .reel__frame:nth-child(4) { --i: 3; }
  .reel__frame video {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--dusk);
  }
  .reel__frame figcaption { margin-top: 0.6rem; color: var(--soft); }
  .reel__frame figcaption strong { color: var(--ink); font-weight: 600; }
  .stage__foot {
    grid-area: 3 / 1 / 4 / 2;
    justify-self: start;
    align-self: end;
    position: relative;
    max-width: 36ch;
  }
  .stage__lede { font-size: var(--step-lead); line-height: 1.35; color: var(--ink); }
  .stage__go { display: none; }

  @media (min-width: 1025px) and (prefers-reduced-motion: no-preference) {
    :global(.js) .stage { height: calc(100svh - 4.5rem + 150svh); }
    :global(.js) .stage__pin { position: sticky; top: 0; height: 100svh; min-height: 0; }
  }

  @media (max-width: 1024px) {
    .stage {
      --hero-size: clamp(2.75rem, 12vw, 5rem);
      --frame-w: calc(100vw - 2 * var(--margin));
      --frame-h: calc(var(--frame-w) * 0.75);
      --sliver: 0px;
      --slot-h: var(--fig-h);
    }
    .stage__pin { grid-template-rows: auto; min-height: 0; padding: 1.5rem var(--margin); }
    .stage__hero { grid-row: 1; grid-template-rows: auto var(--slot-h) auto auto; row-gap: 1rem; }
    .reel { margin-left: 0; }
    .reel__frame video { aspect-ratio: 4 / 3; }
    .stage__foot { grid-area: 4 / 1 / 5 / 2; justify-self: stretch; max-width: none; display: grid; gap: 1.25rem; }
    .stage__lede { font-size: var(--step-body); max-width: 36ch; }
    .stage__go { display: inline-flex; }
  }

  .voice { margin: var(--section) var(--margin) 0; display: grid; justify-items: center; gap: 1.25rem; text-align: center; }
  .voice blockquote { margin: 0; }
  .voice p { max-width: 30ch; font-family: var(--display); font-weight: 500; font-size: clamp(1.5rem, 1rem + 1.4vw, 2.25rem); line-height: 1.25; letter-spacing: -0.01em; color: var(--ink); }
  .voice figcaption { color: var(--soft); }
  .work__more { margin: clamp(4rem, 7vw, 6rem) var(--margin) 0; max-width: 46ch; font-size: var(--step-lead); line-height: 1.35; }

  /* ---------- the ledger ---------- */
  .ledger {
    padding: var(--section) var(--margin) 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 3rem;
    align-items: center;
  }
  .ledger__left { grid-column: 1 / 6; display: grid; gap: 2.5rem; }
  .ledger__left h2 { max-width: none; }
  .ledger__left h2 span { display: block; }
  .ledger__soft { color: var(--soft); }
  .calc { display: grid; gap: 0.6rem; max-width: 26rem; }
  .calc label { font-weight: 600; }
  .calc__row { display: grid; grid-template-columns: minmax(0, 1fr) 6.5rem; align-items: center; gap: 1rem; margin-bottom: 0.75rem; }
  .calc output { font-weight: 600; font-size: var(--step-lead); text-align: right; }
  input[type="range"] { width: 100%; height: 2.75rem; accent-color: var(--ink); cursor: pointer; background: transparent; }
  .ledger__figures { grid-column: 7 / 13; display: grid; gap: 1.25rem; margin: 0; }
  .fig { display: grid; grid-template-columns: 52% minmax(0, 1fr); align-items: baseline; column-gap: 1.5rem; }
  .fig__n {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--step-display);
    line-height: 1;
    letter-spacing: -0.02em;
    text-align: right;
    font-variant-numeric: lining-nums tabular-nums;
    transition: color var(--t-ui) ease;
  }
  .fig__cap { margin: 0; max-width: 26ch; color: var(--soft); }
  .fig--accent .fig__n { color: var(--ember-deep); }
  .ledger__note { grid-column: 7 / 13; max-width: 60ch; }
  @media (max-width: 860px) {
    .ledger__left, .ledger__figures, .ledger__note { grid-column: 1 / -1; }
    .fig { grid-template-columns: 1fr; }
    .fig__n { text-align: left; font-size: clamp(3rem, 15vw, 4.5rem); }
    .fig__cap { margin-top: 0.35rem; }
  }

  /* ---------- how it works: lines that step across ---------- */
  .steps { padding: var(--section) var(--margin) 0; }
  .steps__list { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 3.5rem; }
  .step { grid-column: 1 / -1; }
  .step--1 { grid-column-start: 3; }
  .step--2 { grid-column-start: 5; }
  .step--3 { grid-column-start: 7; }
  .step__line {
    font-family: var(--display);
    font-weight: 600;
    font-size: var(--step-head);
    letter-spacing: -0.025em;
    line-height: 1;
  }
  .step--3 .step__line { color: var(--ember-deep); }
  .step__text { margin-top: 0.75rem; max-width: 34ch; color: var(--soft); }
  @media (max-width: 860px) {
    .steps__list { display: grid; grid-template-columns: 1fr; row-gap: 2.5rem; }
    .step { grid-column: 1; }
    .step--1 { padding-left: 6vw; }
    .step--2 { padding-left: 12vw; }
    .step--3 { padding-left: 18vw; }
  }

  /* ---------- who: picture as a drop cap ---------- */
  .who {
    padding: var(--section) var(--margin) 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
  }
  .who__facts { grid-column: 1 / 3; display: grid; gap: 0.75rem; align-content: start; color: var(--soft); padding-top: 0.4rem; }
  .who__text { grid-column: 3 / 13; }
  .who__p { max-width: none; font-size: var(--step-lead); line-height: 1.3; }
  .who__p + .who__p { margin-top: 1.3em; }
  .who__p strong { font-weight: 600; }
  .who__pic { float: left; width: 3.9em; height: 3.9em; object-fit: cover; margin: 0.25em 0.6em 0 0; }
  @media (max-width: 860px) {
    .who__facts { grid-column: 1 / -1; grid-row: 2; margin-top: 2rem; }
    .who__text { grid-column: 1 / -1; }
    .who__pic { width: 5.2em; height: 5.2em; }
  }

</style>

<script>
  // Hero reel: the page's own scroll moves the frames through the sentence (pinned story).
  const stage = document.querySelector<HTMLElement>(".stage");
  const track = stage?.querySelector<HTMLElement>(".reel__track");
  const frames = Array.from(stage?.querySelectorAll<HTMLElement>(".reel__frame") ?? []);
  const videos = frames.map((f) => f.querySelector("video"));
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  let current = -1;

  function play(i: number) {
    if (i === current) return;
    current = i;
    videos.forEach((v, j) => {
      if (!v) return;
      if (j === i && !reduce) {
        if (v.preload === "none") v.preload = "auto";
        v.play().catch(() => {});
      } else v.pause();
    });
  }

  function onScroll() {
    if (!stage || !track) return;
    const rect = stage.getBoundingClientRect();
    const run = stage.offsetHeight - window.innerHeight;
    const t = run > 0 ? Math.min(1, Math.max(0, -rect.top / run)) : 0;
    const narrow = window.matchMedia("(max-width: 1024px)").matches;
    const p = reduce || narrow ? 0 : t * (frames.length - 1);
    track.style.setProperty("--p", p.toFixed(4));
    play(Math.round(p));
  }
  if (stage && track) {
    onScroll();
    window.addEventListener("scroll", () => requestAnimationFrame(onScroll), { passive: true });
    window.addEventListener("resize", onScroll);
  }

  // The ledger: the visitor's own numbers.
  const feeIn = document.getElementById("calc-fee") as HTMLInputElement | null;
  const yrIn = document.getElementById("calc-years") as HTMLInputElement | null;
  const BUILD = 2000;
  const CARE = 450;
  const fmt = (n: number) => Math.abs(n).toLocaleString("en-US");
  const set = (id: string, text: string) => {
    const el = document.getElementById(id);
    if (el) el.textContent = text;
  };
  function recalc() {
    if (!feeIn || !yrIn) return;
    const fee = Number(feeIn.value);
    const yrs = Number(yrIn.value);
    const rent = fee * 12 * yrs;
    const own = BUILD + CARE * yrs;
    const diff = rent - own;
    const y = yrs === 1 ? "year" : "years";
    set("calc-fee-out", `$${fee}`);
    set("calc-years-out", `${yrs} ${y}`);
    set("fig-rent", fmt(rent));
    set("cap-rent", `dollars renting a platform at $${fee} a month for ${yrs} ${y}, and you own none of it`);
    set("fig-own", fmt(own));
    set("cap-own", `dollars with us over the same ${yrs} ${y}: a build from $2,000 plus Care at $450 a year`);
    set("fig-diff", fmt(diff));
    set("cap-diff", diff >= 0 ? "dollars that stay in your restaurant" : "dollars more with us up front, for a site you keep after you stop paying");
  }
  feeIn?.addEventListener("input", recalc);
  yrIn?.addEventListener("input", recalc);
  recalc();

</script>
