---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import Logo from "../components/Logo.astro";
import { caseStudies, faq, build, carePlans } from "../data/site";
const questions = [faq.pricing[0], faq.pricing[2], faq.services[1]];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((q) => ({
    "@type": "Question",
    name: q.q,
    acceptedAnswer: { "@type": "Answer", text: q.a },
  })),
};
const services = [
  {
    name: "Websites",
    note: "Your digital front door.",
    body: "Custom websites that feel like your restaurant and make the next step easy. Find the menu. Book the table. Place the order.",
    details: "Custom design · Mobile-first · Search foundations",
    href: "/websites-for-restaurants",
  },
  {
    name: "Brand & identity",
    note: "A look that belongs to you.",
    body: "From the sign above your door to the menu in their hands. A distinctive identity that brings your restaurant’s personality into focus.",
    details: "Logo & identity · Menu design · Art direction",
    href: "/services#brand",
  },
  {
    name: "Photo & video",
    note: "Give them a taste.",
    body: "The space, the plates, the people. On-site photography and film that capture what makes your place worth coming back to.",
    details: "On-site shoots · Food & interiors · Brand films",
    href: "/services#capture",
  },
  {
    name: "Care & support",
    note: "Still here after opening night.",
    body: "Your restaurant changes. Your website should keep up. Hosting, maintenance, and real people behind every update, with one clear annual fee.",
    details: "Hosting · Website updates · The Host AI assistant",
    href: "/services#care",
  },
];
---

<Base
  title="Restaurant websites, branding & a better first impression"
  description="A creative studio built only for restaurants. Custom websites, brand identity, photography, and ongoing care. Websites you own from $2,000."
  jsonLd={jsonLd}
>
  <section class="hero" data-od-id="first-impression">
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="kicker hero__eyebrow">
          <span></span> THE CREATIVE STUDIO FOR RESTAURANTS
        </p>
        <h1>
          Good hospitality
          <br />
          starts before
          <br />
          <em>the door.</em>
        </h1>
        <p class="hero__intro">
          You make people feel at home.
          <br />
          We make sure they find you.
        </p>
        <p class="hero__body">
          Distinctive brands, beautiful websites, and the people to keep them
          going. Built for independent restaurants. Owned by you.
        </p>
        <div class="hero__actions">
          <a href="/work" class="btn btn--primary">
            Explore our work <span aria-hidden="true">↗</span>
          </a>
          <a href="/contact" class="hero__secondary">
            Let's meet <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="hero__visual">
        <div class="hero__photo">
          <img
            src="/images/brand/hospitality-editorial.webp"
            srcset="/images/brand/hospitality-editorial-small.webp 600w, /images/brand/hospitality-editorial.webp 1122w"
            sizes="(max-width: 760px) 90vw, 38vw"
            alt="Warm light, a table set for dinner, and an open doorway into a welcoming restaurant. Brand illustration."
            width="1122"
            height="1402"
            fetchpriority="high"
            decoding="async"
          />
        </div>
        <div
          class="hero__seal"
          aria-label="Independent restaurants. All heart."
        >
          <span>
            INDEPENDENT
            <br />
            RESTAURANTS
          </span>
          <Logo variant="mark" />
          <span>ALL HEART.</span>
        </div>
        <p class="hero__caption">
          <span>A little more welcome.</span>
          <span>A lot more you.</span>
        </p>
      </div>
    </div>
    <div class="container">
      <div class="hero__foot">
        <span>RESTAURANT PEOPLE. CREATIVE PEOPLE. YOUR PEOPLE.</span>
        <a href="#selected-work">
          COME ON IN <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <section class="work section" id="selected-work" data-od-id="selected-work">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker">A FEW PLACES WE'VE SET THE TABLE</p>
          <h2>
            Different restaurants.
            <br />
            Same care.
          </h2>
        </div>
        <a class="text-link" href="/work">
          Take a closer look <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="work__grid">
        {caseStudies.map((c, i) => (
          <article class={`project project--${i}`}>
            <a
              href={c.url}
              target="_blank"
              rel="noopener noreferrer"
              class="project__image"
              aria-label={`Visit ${c.name}'s live website, opens in a new tab`}
            >
              <div class="project__browser">
                <span class="browser__dots" aria-hidden="true">
                  <i></i>
                  <i></i>
                  <i></i>
                </span>
                <span>{i === 0 ? "burgerlabbar.com" : "killanikkei.com"}</span>
                <span aria-hidden="true">↗</span>
              </div>
              <img
                src={c.video.poster}
                alt={`${c.name} restaurant website designed by the Front of House team`}
                width="1280"
                height="720"
                loading="lazy"
              />
              <span class="project__view">Visit the live site ↗</span>
            </a>
            <div class="project__meta">
              <div>
                <h3>{c.name}</h3>
                <p>
                  {c.type} · {c.location}
                </p>
              </div>
              <a
                href={c.url}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Visit ${c.name} website, opens in a new tab`}
              >
                ↗
              </a>
            </div>
            <p class="project__services">
              {i === 0
                ? "WEBSITE DESIGN · ONLINE ORDERING · SEARCH"
                : "WEBSITE DESIGN · RESERVATIONS · NEWSLETTER"}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="templates" class="concepts" data-od-id="templates">
    <div class="container concepts__inner">
      <div class="concepts__type" aria-hidden="true">
        Your
        <br />
        <em>name here.</em>
      </div>
      <div>
        <p class="kicker">TEMPLATES · TRY YOUR RESTAURANT FIRST</p>
        <h2>Picture your place.</h2>
        <p>
          Put your restaurant’s name on four working previews. Try your brand
          colors, switch between desktop and phone, and explore ten design
          directions. Save your favorites to start a build brief.
        </p>
        <a href="/templates" class="text-link">
          Explore Templates <span aria-hidden="true">↗</span>
        </a>
        <p class="concepts__note">Your name. Your colors. No email needed.</p>
      </div>
    </div>
  </section>

  <section class="studio section" data-od-id="studio-services">
    <div class="container studio__grid">
      <div class="studio__intro">
        <p class="kicker">YOUR PLACE. OUR KIND OF PROJECT.</p>
        <h2>
          You bring
          <br />
          the good food.
          <br />
          <em>
            We'll bring
            <br />
            the rest.
          </em>
        </h2>
        <p>
          A neighborhood favorite. A new opening. A small group with big ideas.
          We help the right people discover what makes your restaurant yours.
        </p>
        <a class="text-link" href="/services">
          Everything we do <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="service-menu">
        {services.map((s, i) => (
          <details class="service" name="services" open={i === 0}>
            <summary>
              <span>{s.name}</span>
              <span class="service__plus" aria-hidden="true">
                +
              </span>
            </summary>
            <div class="service__content">
              <h3>{s.note}</h3>
              <p>{s.body}</p>
              <p class="service__details">{s.details}</p>
              <a href={s.href}>
                Explore {s.name.toLowerCase()} <span aria-hidden="true">↗</span>
              </a>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="ownership section" data-od-id="ownership">
    <div class="container ownership__grid">
      <div class="ownership__copy">
        <p class="kicker">THE HOUSE RULE</p>
        <h2>
          Your restaurant.
          <br />
          Your website.
          <br />
          <em>Yours. Period.</em>
        </h2>
        <p>
          You put everything into your business. Your website should be an asset
          you own, with the code to keep and a team you can call.
        </p>
        <a href="/pricing" class="btn btn--on-ink">
          Refreshingly simple pricing <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="receipt">
        <div class="receipt__heading">
          <Logo variant="inline" />
          <span>YOUR NEXT CHAPTER</span>
        </div>
        <p class="receipt__intro">
          A great first impression.
          <br />A straightforward investment.
        </p>
        <div class="receipt__item">
          <div>
            <h3>The custom build</h3>
            <p>Designed, built, and yours to keep.</p>
          </div>
          <div class="receipt__price">
            <small>FROM</small>
            {build.from}
            <small>ONE TIME</small>
          </div>
        </div>
        <div class="receipt__item">
          <div>
            <h3>Care</h3>
            <p>Hosting, updates, and a real team.</p>
          </div>
          <div class="receipt__price">
            {carePlans[0].price}
            <small>PER YEAR</small>
          </div>
        </div>
        <div class="receipt__note">
          <span aria-hidden="true">↳</span> A little more support? Care+ adds
          ongoing marketing for {carePlans[1].price}/year.
        </div>
        <p class="receipt__bottom">
          YOUR NAME ON THE DOOR. YOUR NAME ON THE CODE.
        </p>
        <p class="receipt__fine">
          Scope agreed up front. Domains, third-party tools, and additional work
          quoted separately.
        </p>
      </div>
    </div>
  </section>

  <section class="process section" data-od-id="the-process">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="kicker">FROM FIRST HELLO TO WHAT'S NEXT</p>
          <h2>
            Good people.
            <br />A clear process.
          </h2>
        </div>
        <p class="section-head__note">
          Restaurant operators and creative builders.
          <br />
          One team on your side.
        </p>
      </div>
      <div class="process__steps">
        <article>
          <span class="process__number">01 / MEET</span>
          <h3>First, your story.</h3>
          <p>
            We get to know your restaurant, your guests, and where you want to
            go. Then we agree on a scope and a price.
          </p>
        </article>
        <article>
          <span class="process__number">02 / MAKE</span>
          <h3>Made around you.</h3>
          <p>
            We design, build, and bring your place to life online. You see it,
            refine it with us, and approve it before launch.
          </p>
        </article>
        <article>
          <span class="process__number">03 / KEEP GOING</span>
          <h3>Consider us regulars.</h3>
          <p>
            You own the website. We keep it hosted and current. Need a change?
            Ask the Host or reach our team directly.
          </p>
        </article>
      </div>
      <a class="text-link" href="/about">
        Meet your new people <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section class="questions section" data-od-id="questions">
    <div class="container questions__grid">
      <div>
        <p class="kicker">BEFORE YOU PULL UP A CHAIR</p>
        <h2>
          A few good
          <br />
          questions.
        </h2>
        <a class="text-link" href="/pricing#faq">
          More about pricing <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div>
        {questions.map((q) => (
          <details class="question">
            <summary>
              {q.q}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{q.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .hero {
    padding-top: clamp(2.4rem, 4.6vw, 4.5rem);
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 4%;
    align-items: center;
  }
  .hero__copy {
    padding-bottom: 1.5rem;
  }
  .hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.6rem;
    margin-bottom: 2.1rem;
    color: var(--ink);
  }
  .hero__eyebrow > span {
    width: 6px;
    height: 6px;
    background: var(--ember);
    border-radius: 50%;
    flex: none;
  }
  .hero h1 {
    font-size: clamp(3.5rem, 6.05vw, 6rem);
    line-height: 1.02;
    letter-spacing: -0.062em;
    font-weight: 550;
    margin: 0 0 1.55rem;
  }
  .hero h1 em {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.33em;
    line-height: 0.9;
    color: var(--ember);
    letter-spacing: -0.055em;
  }
  .hero__intro {
    font-size: 1rem;
    line-height: 1.55;
    color: var(--ink);
    margin-bottom: 0.65rem;
  }
  .hero__body {
    font-size: 0.85rem;
    max-width: 43ch;
    line-height: 1.75;
    color: var(--muted);
    margin-bottom: 1.9rem;
  }
  .hero__actions {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .hero__secondary {
    font-size: 0.78rem;
    color: var(--ink);
    display: flex;
    gap: 1.5rem;
    align-items: center;
    min-height: 44px;
  }
  .hero__secondary:hover {
    color: var(--ember);
  }
  .hero__visual {
    position: relative;
    align-self: stretch;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .hero__photo {
    height: clamp(460px, 42vw, 575px);
    border-radius: 48% 48% 2px 2px;
    overflow: hidden;
    background: var(--bone);
  }
  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 52%;
  }
  .hero__caption {
    display: flex;
    justify-content: space-between;
    font-size: 0.61rem;
    color: var(--muted);
    margin: 0.9rem 0 0;
    letter-spacing: 0.015em;
  }
  .hero__seal {
    width: 116px;
    height: 116px;
    position: absolute;
    bottom: 67px;
    left: -46px;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ember);
    border: 1px solid var(--ember);
    outline: 6px solid var(--paper);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    transform: rotate(-12deg);
  }
  .hero__seal > span {
    font-size: 0.5rem;
    line-height: 1.3;
    text-align: center;
    letter-spacing: 0.1em;
    font-weight: 600;
  }
  .hero__seal :global(.logo) {
    width: 27px;
  }
  .hero__foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    border-bottom: 1px solid var(--line);
    margin-top: 3.2rem;
    padding-bottom: 1.3rem;
    font-size: 0.56rem;
    letter-spacing: 0.12em;
    color: var(--muted);
  }
  .hero__foot a {
    color: var(--ink);
    display: flex;
    gap: 1.5rem;
    min-height: 30px;
    align-items: center;
  }
  .hero__foot a span {
    font-size: 1rem;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin-bottom: 2.7rem;
  }
  .section-head h2 {
    margin: 0;
  }
  .section-head > .text-link {
    margin-bottom: 0.25rem;
  }
  .work {
    padding-top: 5rem;
  }
  .work__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .project__image {
    display: block;
    position: relative;
    padding: 3.2rem 2.5rem;
    overflow: hidden;
    background: #dfdfd5;
  }
  .project--1 .project__image {
    background: #d9c8b9;
  }
  .project__browser {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #f6f5f1;
    border-radius: 5px 5px 0 0;
    padding: 0.5rem 0.65rem;
    font-size: 0.48rem;
    letter-spacing: 0.01em;
    color: var(--muted);
  }
  .browser__dots {
    display: flex;
    gap: 3px;
  }
  .browser__dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #b8b3a9;
  }
  .project__image img {
    width: 100%;
    height: auto;
    box-shadow: 0 15px 30px #29251f24;
    transition: transform 0.35s;
    aspect-ratio: 16/9;
    object-fit: cover;
  }
  .project__view {
    position: absolute;
    inset: auto 50% 1rem auto;
    transform: translate(50%, 5px);
    opacity: 0;
    font-size: 0.61rem;
    background: var(--paper);
    color: var(--ink);
    padding: 0.45rem 1rem;
    border-radius: 2px;
    transition:
      opacity 0.2s,
      transform 0.2s;
    white-space: nowrap;
  }
  .project__image:hover .project__view,
  .project__image:focus-visible .project__view {
    opacity: 1;
    transform: translate(50%, 0);
  }
  .project__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding-top: 1.35rem;
  }
  .project__meta h3 {
    font-size: 1.6rem;
    letter-spacing: -0.035em;
    margin: 0 0 0.4rem;
  }
  .project--1 h3 {
    font-family: var(--serif);
    font-size: 2.1rem;
    line-height: 0.9;
  }
  .project__meta p {
    font-size: 0.66rem;
    color: var(--muted);
    margin: 0;
  }
  .project__meta > a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ink);
    font-size: 1.2rem;
  }
  .project__meta > a:hover {
    background: var(--ink);
    color: var(--paper);
  }
  .project__services {
    font-size: 0.51rem;
    letter-spacing: 0.1em;
    color: var(--muted);
    margin: 1.1rem 0 0;
  }
  .studio {
    background: var(--bone);
  }
  .studio__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    gap: 11%;
  }
  .studio__intro h2 {
    font-size: clamp(2.8rem, 4.6vw, 4.6rem);
  }
  .studio__intro h2 em {
    font-family: var(--serif);
    font-weight: 500;
    font-size: 1.2em;
    line-height: 0.9;
    color: var(--ember);
  }
  .studio__intro > p:not(.kicker) {
    font-size: 0.88rem;
    max-width: 38ch;
    margin-block: 1.6rem 1.3rem;
  }
  .service-menu {
    align-self: center;
    border-top: 1px solid var(--line);
  }
  .service {
    border-bottom: 1px solid var(--line);
  }
  .service summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 0;
    list-style: none;
    cursor: pointer;
    font-family: var(--display);
    font-size: 1.5rem;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .service__plus {
    font-family: var(--sans);
    font-size: 1.5rem;
    font-weight: 300;
    transition: transform 0.2s;
  }
  .service[open] .service__plus {
    transform: rotate(45deg);
  }
  .service[open] summary {
    color: var(--ember);
  }
  .service__content {
    padding: 0.1rem 2rem 1.8rem 0;
  }
  .service__content h3 {
    font-family: var(--sans);
    font-size: 0.83rem;
    letter-spacing: 0;
    font-weight: 500;
    margin-bottom: 0.8rem;
  }
  .service__content p {
    font-size: 0.85rem;
    line-height: 1.8;
    max-width: 48ch;
  }
  .service__content .service__details {
    font-size: 0.62rem;
    color: var(--muted);
    margin-bottom: 1.2rem;
  }
  .service__content a {
    font-size: 0.7rem;
    display: inline-flex;
    gap: 1.5rem;
    align-items: center;
    min-height: 30px;
  }
  .ownership {
    background: var(--ember);
    color: var(--paper);
  }
  .ownership__grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 12%;
    align-items: center;
  }
  .ownership .kicker {
    color: var(--paper);
  }
  .ownership h2 {
    font-size: clamp(2.8rem, 4.8vw, 4.8rem);
    color: var(--paper);
  }
  .ownership h2 em {
    font-family: var(--serif);
    font-size: 1.19em;
    font-weight: 500;
    letter-spacing: -0.04em;
  }
  .ownership__copy > p:not(.kicker) {
    font-size: 0.9rem;
    max-width: 41ch;
    margin: 1.6rem 0 2rem;
    color: var(--paper);
  }
  .ownership :focus-visible {
    outline-color: var(--paper);
  }
  .receipt {
    background: var(--paper);
    color: var(--ink);
    padding: 2rem 2.2rem 2.5rem;
    transform: rotate(2deg);
    position: relative;
    box-shadow: 0 12px 30px #60201330;
  }
  .receipt::after {
    content: "";
    position: absolute;
    inset: auto 0 -7px;
    height: 8px;
    background:
      linear-gradient(135deg, var(--paper) 25%, transparent 25%) -4px 0/16px
        16px,
      linear-gradient(225deg, var(--paper) 25%, transparent 25%) -4px 0/16px
        16px;
  }
  .receipt__heading {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    padding-bottom: 1.4rem;
    border-bottom: 1px dashed var(--line);
  }
  .receipt__heading > span {
    font-size: 0.46rem;
    letter-spacing: 0.13em;
    color: var(--muted);
    text-align: right;
    max-width: 8ch;
