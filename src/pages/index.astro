---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import HeroVideo from "../components/templates/HeroVideo.astro";
import { Image } from "astro:assets";
import {
  caseStudies,
  faq,
  build,
  carePlans,
  portfolioVideo,
} from "../data/site";
import { directions } from "../data/directions";
const questions = [faq.pricing[0], faq.pricing[2], faq.services[1]];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: questions.map((q) => ({
    "@type": "Question",
    name: q.q,
    acceptedAnswer: { "@type": "Answer", text: q.a },
  })),
};
const services = [
  {
    name: "Websites",
    note: "A site that feels like your place.",
    body: "Distinctive design. Menus that are easy to find. A clear path to book a table or place an order. Built around your guests, and yours to keep.",
    href: "/websites-for-restaurants",
  },
  {
    name: "Brand & identity",
    note: "Make it unmistakably yours.",
    body: "The logo, the menu, the little details. A considered identity that carries your restaurant’s personality from the street to the screen.",
    href: "/services#brand",
  },
  {
    name: "Photo & video",
    note: "Let people feel the room.",
    body: "On-site photography and film that capture your food, your people, and the atmosphere they create together.",
    href: "/services#capture",
  },
  {
    name: "Care & support",
    note: "A team that stays at the table.",
    body: "Hosting, maintenance, and ongoing updates. Ask the Host AI assistant for a change, and our team reviews it before it goes live.",
    href: "/services#care",
  },
];
---

<Base
  title="Restaurant websites, branding & a better first impression"
  description="Websites, brands, and content for independent restaurants. Explore our work, try a design with your restaurant’s name, and build a website you own."
  jsonLd={jsonLd}
>
  <section class="opening container" data-od-id="first-impression">
    <div class="opening__top">
      <p class="kicker">FRONT OF HOUSE / A RESTAURANT CREATIVE STUDIO</p>
      <span class="opening__note">Made for the places people love.</span>
    </div>
    <div class="opening__grid">
      <h1>
        A taste of
        <br />
        <em>what’s next.</em>
      </h1>
      <div class="opening__copy">
        <p>
          Give your restaurant
          <br />a presence worth <em>pulling up for.</em>
        </p>
        <p class="opening__description">
          Distinctive websites, brands, and content. Built by restaurant people,
          for restaurant people.
        </p>
        <a href="/templates" class="btn btn--primary">
          Find your direction <span aria-hidden="true">↗</span>
        </a>
        <a href="/work" class="opening__link">
          Explore our work <span aria-hidden="true">↓</span>
        </a>
      </div>
    </div>
  </section>

  <section class="feature container" aria-label="Featured restaurant project">
    <div class="feature__frame">
      <HeroVideo
        {...portfolioVideo.killaHero}
        label="the Killa restaurant film"
        className="feature__film"
      />
      <div class="feature__caption">
        <span>IN GOOD COMPANY</span>
        <a
          href="https://www.killanikkei.com"
          target="_blank"
          rel="noopener noreferrer"
        >
          Killa <span aria-hidden="true">↗</span>
        </a>
        <p>Peruvian–Japanese. Salt Lake City.</p>
      </div>
    </div>
    <div class="feature__credit">
      <p>A real place. A distinct point of view.</p>
      <a href="/work">
        Meet the restaurants <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>

  <section
    class="selected container"
    id="selected-work"
    data-od-id="selected-work"
  >
    <div class="section-heading">
      <div>
        <p class="kicker">01 / SELECTED WORK</p>
        <h2>
          Personality.
          <br />
          On every page.
        </h2>
      </div>
      <p>
        Different menus. Different moods.
        <br />
        Always a website that belongs to the restaurant.
      </p>
    </div>
    <div class="work-grid">
      {caseStudies.map((c, i) => (
        <article class="project">
          <a
            href={c.url}
            target="_blank"
            rel="noopener noreferrer"
            class="project__image"
            aria-label={`Visit ${c.name} website, opens in a new tab`}
          >
            <img
              src={c.video.poster}
              alt={`${c.name} restaurant website designed by the Front of House team`}
              width="1920"
              height="1080"
              loading="lazy"
            />
            <span class="project__visit">Visit the site ↗</span>
          </a>
          <div class="project__caption">
            <div>
              <h3>{c.name}</h3>
              <p>{c.type}</p>
            </div>
            <span class="project__number">0{i + 1} ↗</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="directions" id="templates" data-od-id="templates">
    <div class="container">
      <div class="section-heading">
        <div>
          <p class="kicker">02 / THE TEMPLATE STUDIO</p>
          <h2>
            See your place
            <br />
            in a new light.
          </h2>
        </div>
        <div class="directions__intro">
          <p>
            Your name. Your colors. Four working previews and ten directions to
            make your own.
          </p>
          <a href="/templates" class="text-link">
            Explore Templates <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="direction-grid">
        {directions.slice(0, 4).map((d, i) => (
          <a href={d.href} class={`direction direction--${i}`}>
            <div class="direction__photo">
              <Image
                src={d.image}
                alt={d.imageAlt}
                width={640}
                format="webp"
                loading="lazy"
              />
              <div class="direction__sample" aria-hidden="true">
                {[
                  "The evening<br>is yours.",
                  "GOOD FOOD.<br>GREAT TIMES.",
                  "A table for<br>everyone.",
                  "Your usual.<br>Only better.",
                ][i]
                  .split("<br>")
                  .map((line) => (
                    <span>{line}</span>
                  ))}
              </div>
              <span class="direction__tag">LIVE PREVIEW</span>
            </div>
            <div class="direction__caption">
              <span>{d.label}</span>
              <span aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
      <p class="directions__foot">
        Try it with your restaurant’s name. No email needed.
      </p>
    </div>
  </section>

  <section class="services container" data-od-id="studio-services">
    <div class="services__intro">
      <p class="kicker">03 / WHAT WE BRING</p>
      <h2>
        The whole
        <br />
        first impression.
      </h2>
      <p>
        From your identity to the everyday updates. One creative partner who
        understands how restaurants work.
      </p>
      <a href="/about" class="text-link">
        Meet the studio <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="service-list">
      {services.map((s, i) => (
        <details class="service" name="homepage-services" open={i === 0}>
          <summary>
            <span class="service__number">0{i + 1}</span>
            <span>{s.name}</span>
            <span class="service__plus" aria-hidden="true">
              +
            </span>
          </summary>
          <div class="service__body">
            <h3>{s.note}</h3>
            <p>{s.body}</p>
            <a href={s.href}>
              Explore {s.name.toLowerCase()} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </details>
      ))}
    </div>
  </section>

  <section class="ownership" data-od-id="ownership">
    <div class="container ownership__grid">
      <div>
        <p class="kicker">A BETTER WAY TO BUILD</p>
        <h2>
          Your website.
          <br />
          <em>Yours to keep.</em>
        </h2>
        <p>
          A custom build, clear pricing, and the code in your hands. We stay to
          help because you want us to.
        </p>
        <a href="/pricing" class="text-link">
          See the pricing <span aria-hidden="true">↗</span>
        </a>
      </div>
      <div class="pricing">
        <div class="pricing__row">
          <div>
            <span class="pricing__label">CUSTOM WEBSITE</span>
            <p>Designed around your restaurant.</p>
          </div>
          <div class="pricing__amount">
            <small>FROM</small>
            <strong>{build.from}</strong>
            <span>one time</span>
          </div>
        </div>
        <div class="pricing__row">
          <div>
            <span class="pricing__label">ONGOING CARE</span>
            <p>Hosting, updates, and a real team.</p>
          </div>
          <div class="pricing__amount">
            <strong>{carePlans[0].price}</strong>
            <span>per year</span>
          </div>
        </div>
        <p class="pricing__fine">
          Care+ with ongoing marketing: {carePlans[1].price}/year. Scope agreed
          up front. Domains and third-party tools quoted separately.
        </p>
      </div>
    </div>
  </section>

  <section class="questions container" data-od-id="questions">
    <div>
      <p class="kicker">BEFORE WE SAY HELLO</p>
      <h2>
        A few good
        <br />
        questions.
      </h2>
    </div>
    <div>
      {questions.map((q) => (
        <details class="question">
          <summary>
            {q.q}
            <span aria-hidden="true">+</span>
          </summary>
          <p>{q.a}</p>
        </details>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .opening {
    padding-top: 2.5rem;
    padding-bottom: 3.5rem;
  }
  .opening__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .opening__top .kicker {
    margin: 0;
    color: var(--ink);
    font-size: 0.59rem;
  }
  .opening__note {
    font-size: 0.7rem;
    color: var(--muted);
  }
  .opening__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: 5%;
    align-items: end;
  }
  .opening h1 {
    font-size: clamp(5rem, 8.8vw, 8.6rem);
    line-height: 0.96;
    letter-spacing: -0.07em;
    font-weight: 550;
    margin: 0;
    color: var(--ember);
  }
  .opening h1 em {
    font-family: var(--serif);
    font-weight: 500;
    letter-spacing: -0.055em;
    font-size: 1.06em;
  }
  .opening__copy {
    max-width: 350px;
    justify-self: end;
    padding-bottom: 0.2rem;
  }
  .opening__copy > p:first-child {
    font-size: 1.32rem;
    color: var(--ink);
    line-height: 1.4;
    letter-spacing: -0.035em;
    margin-bottom: 0.8rem;
  }
  .opening__copy em {
    font-style: normal;
  }
  .opening__description {
    font-size: 0.82rem;
    line-height: 1.7;
    margin-bottom: 1.4rem;
    max-width: 34ch;
  }
  .opening__copy .btn {
    font-size: 0.74rem;
    padding: 0.85rem 1.1rem;
    min-height: 48px;
    width: 100%;
    justify-content: space-between;
  }
  .opening__link {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.75rem;
    min-height: 44px;
    margin-top: 0.25rem;
    color: var(--ink);
  }
  .feature__frame {
    height: clamp(360px, 38vw, 570px);
    position: relative;
    overflow: hidden;
    background: var(--ink);
  }
  .feature__frame :global(.feature__film) {
    position: absolute;
    inset: 0;
    height: 100%;
    width: 100%;
  }
  .feature__frame:after {
    content: "";
    position: absolute;
    inset: 35% 0 0;
    background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
    pointer-events: none;
  }
  .feature__frame :global(.hero-video__toggle) {
    z-index: 3;
  }
  .feature__caption {
    position: absolute;
    left: 2rem;
    bottom: 1.7rem;
    z-index: 2;
    color: white;
  }
  .feature__caption > span {
    font-size: 0.55rem;
    letter-spacing: 0.16em;
    display: block;
    margin-bottom: 0.55rem;
  }
  .feature__caption > a {
    font: 550 2.8rem/1 var(--display);
    color: white;
    letter-spacing: -0.06em;
    display: flex;
    align-items: center;
    gap: 2rem;
  }
  .feature__caption > a > span {
    font: 400 1.4rem var(--sans);
  }
  .feature__caption p {
    font-size: 0.65rem;
    margin: 0.5rem 0 0;
    color: #eee;
  }
  .feature__credit {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    font-size: 0.65rem;
    padding: 1rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
  }
  .feature__credit p {
    margin: 0;
  }
  .feature__credit a {
    color: var(--ink);
  }
  .selected {
    padding-block: 6rem;
  }
  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 3rem;
    margin-bottom: 2.5rem;
  }
  .section-heading h2 {
    margin: 0;
    font-size: clamp(2.6rem, 4.3vw, 4.6rem);
    letter-spacing: -0.055em;
  }
  .section-heading > p {
    font-size: 0.84rem;
    line-height: 1.7;
    max-width: 33ch;
    margin: 0 0 0.4rem;
  }
  .work-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .project__image {
    display: block;
    position: relative;
    overflow: hidden;
    aspect-ratio: 16/10;
    background: var(--toast);
  }
  .project__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.6s;
  }
  .project__image:hover img {
    transform: scale(1.025);
  }
  .project__visit {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    background: var(--paper);
    color: var(--ink);
    padding: 0.55rem 0.8rem;
    font-size: 0.65rem;
  }
  .project__caption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.1rem;
  }
  .project__caption h3 {
    font-size: 1.45rem;
    letter-spacing: -0.035em;
    margin: 0 0 0.3rem;
  }
  .project__caption p {
    font-size: 0.72rem;
    color: var(--muted);
    margin: 0;
  }
  .project__number {
    font-size: 0.7rem;
    color: var(--muted);
  }
  .directions {
    background: var(--bone);
    padding-block: 5.5rem;
  }
  .directions__intro {
    max-width: 33ch;
    font-size: 0.84rem;
  }
  .directions__intro p {
    line-height: 1.75;
  }
  .directions__intro .text-link {
    font-size: 0.78rem;
  }
  .direction-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
  }
  .direction {
    min-width: 0;
    color: var(--ink);
  }
  .direction__photo {
    position: relative;
    aspect-ratio: 4/5;
    overflow: hidden;
    background: var(--ink);
  }
  .direction__photo img {
    height: 100%;
    width: 100%;
    object-fit: cover;
    transition: transform 0.6s;
    filter: brightness(0.58);
  }
  .direction:hover img {
    transform: scale(1.04);
  }
  .direction__sample {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.5vw, 2.6rem);
    line-height: 1;
    color: #fff6e4;
    letter-spacing: -0.025em;
    padding: 0.6rem;
  }
  .direction--1 .direction__sample {
    font-family: var(--display);
    font-weight: 750;
    letter-spacing: -0.065em;
    font-size: clamp(1.2rem, 2vw, 2rem);
    color: #fff2b8;
  }
  .direction--2 .direction__sample {
    font-style: italic;
  }
  .direction--3 .direction__sample {
    font-family: var(--display);
    font-size: clamp(1.2rem, 2vw, 2rem);
    font-weight: 700;
  }
  .direction__tag {
    position: absolute;
    top: 1rem;
    left: 1rem;
    color: white;
    font-size: 0.5rem;
    letter-spacing: 0.15em;
  }
  .direction__caption {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.7rem;
    padding: 0.8rem 0;
    line-height: 1.5;
  }
  .directions__foot {
    font-size: 0.7rem;
    color: var(--muted);
    margin: 1.5rem 0 0;
  }
  .services {
    padding-block: 6rem;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 12%;
  }
  .services__intro h2 {
    font-size: clamp(2.5rem, 4vw, 4rem);
    letter-spacing: -0.055em;
  }
  .services__intro > p:not(.kicker) {
    font-size: 0.85rem;
    max-width: 34ch;
    margin-block: 1.5rem;
  }
  .services__intro .text-link {
    font-size: 0.77rem;
  }
  .service {
    border-top: 1px solid var(--line);
  }
  .service:last-child {
    border-bottom: 1px solid var(--line);
  }
  .service summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.5rem 0;
    list-style: none;
    cursor: pointer;
    color: var(--ink);
    font: 550 clamp(1.3rem, 2vw, 1.8rem)/1.15 var(--display);
    letter-spacing: -0.035em;
  }
  .service summary::-webkit-details-marker {
    display: none;
  }
  .service__number {
    font: 400 0.6rem var(--sans);
    color: var(--muted);
    margin-right: 0.25rem;
  }
  .service__plus {
    margin-left: auto;
    font: 400 1.2rem var(--sans);
  }
  .service[open] .service__plus {
    transform: rotate(45deg);
  }
  .service__body {
    padding: 0 0 1.7rem 2.2rem;
  }
  .service__body h3 {
    font: 600 0.85rem var(--sans);
    letter-spacing: -0.015em;
    margin-bottom: 0.7rem;
  }
  .service__body p {
    font-size: 0.8rem;
    max-width: 47ch;
    line-height: 1.8;
  }
  .service__body a {
    font-size: 0.72rem;
    color: var(--ember);
  }
  .ownership {
    background: var(--ink);
    padding-block: 5.5rem;
    color: var(--paper);
  }
  .ownership__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12%;
    align-items: center;
  }
  .ownership .kicker {
    color: #e4b6a7;
  }
  .ownership h2 {
    color: var(--paper);
    font-size: clamp(2.6rem, 4.3vw, 4.5rem);
  }
  .ownership h2 em {
    font-family: var(--serif);
    font-weight: 500;
    color: #f0b8a6;
    font-size: 1.12em;
  }
  .ownership__grid > div > p:not(.kicker) {
    font-size: 0.84rem;
    max-width: 35ch;
    margin-block: 1.5rem;
    color: #d4cec5;
  }
  .ownership .text-link {
    color: var(--paper);
    font-size: 0.78rem;
  }
  .pricing__row {
    padding-block: 1.5rem;
    border-bottom: 1px solid #5e564d;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
  }
  .pricing__row:first-child {
    border-top: 1px solid #5e564d;
  }
  .pricing__label {
    font-size: 0.61rem;
    letter-spacing: 0.1em;
  }
  .pricing__row p {
    font-size: 0.73rem;
    color: #d4cec5;
    margin: 0.5rem 0 0;
    max-width: 23ch;
  }
  .pricing__amount {
    display: flex;
    flex-direction: column;
    text-align: right;
    flex: none;
  }
  .pricing__amount strong {
    font: 500 2.6rem/1.1 var(--display);
    letter-spacing: -0.055em;
  }
  .pricing__amount span,
  .pricing__amount small {
    font-size: 0.58rem;
    color: #d4cec5;
  }
  .pricing__amount small {
    margin-bottom: 0.35rem;
    letter-spacing: 0.1em;
  }
  .pricing__fine {
    font-size: 0.65rem !important;
    line-height: 1.8;
    margin: 1.2rem 0 0 !important;
    color: #c5bdb3 !important;
    max-width: none !important;
  }
  .questions {
    padding-block: 5.5rem;
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 12%;
  }
  .questions h2 {
    font-size: clamp(2.3rem, 3.7vw, 3.5rem);
  }
  .question {
    border-top: 1px solid var(--line);
  }
  .question:last-child {
    border-bottom: 1px solid var(--line);
  }
  .question summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    list-style: none;
    font-size: 0.84rem;
    color: var(--ink);
    cursor: pointer;
    padding: 1.4rem 0;
  }
  .question summary::-webkit-details-marker {
    display: none;
  }
  .question summary span {
    flex: none;
    font-size: 1.2rem;
  }
  .question[open] summary span {
    transform: rotate(45deg);
  }
  .question p {
    font-size: 0.79rem;
    line-height: 1.85;
    padding-bottom: 0.6rem;
  }
  @media (min-width: 1700px) {
    .opening__grid {
      gap: 10%;
    }
  }
  @media (max-width: 1000px) {
    .opening h1 {
      font-size: 8.8vw;
    }
    .opening__grid {
      grid-template-columns: 1.4fr 1fr;
      gap: 4%;
    }
    .opening__copy > p:first-child {
      font-size: 1.15rem;
    }
    .opening__description {
      font-size: 0.78rem;
    }
    .services,
    .ownership__grid,
    .questions {
      gap: 7%;
    }
    .direction-grid {
      gap: 0.8rem;
