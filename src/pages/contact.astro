---
// Contact: the page that turns a visit into a meeting. One invitation, the form, what happens next.
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import WorkStrip from "../components/WorkStrip.astro";
import { site, cta } from "../data/site.ts";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  name: "Talk to the Front of House team",
  description:
    "Tell Front of House about your restaurant. Custom websites you own from $2,000, then flat yearly care from $450. We reply within one business day.",
  url: `${site.url}/contact`,
  mainEntity: { "@id": `${site.url}/#organization` },
};

const next = [
  { line: "We read it the same day.", text: "A person on the team, not a ticket queue. If it helps, we look at your current site and menu first." },
  { line: "You get a scope and a price.", text: "Within one business day: what we would build, what it costs, and which Care plan fits." },
  { line: "Then we meet.", text: "On a call, or at your place if you are in Park City, Salt Lake City or metro Atlanta. No obligation either way." },
];
---

<Base
  title="Talk to the team"
  description="Tell Front of House about your restaurant. We reply within one business day with a scope, a price and a time to meet. Custom websites you own from $2,000, flat yearly care from $450."
  jsonLd={jsonLd}
>
  <section class="intro" aria-labelledby="contact-title">
    <h1 id="contact-title">{cta.label}</h1>
    <div class="intro__side" data-reveal>
      <p class="lead">Tell us about your restaurant. {cta.promise}</p>
      <p class="intro__direct">
        <a class="link" href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        <a class="link" href={site.contact.phoneHref}>{site.contact.phone}</a>
      </p>
    </div>
  </section>

  <LeadForm id="form" heading="Tell us about your restaurant" tight />

  <WorkStrip statement="Who you will be talking to: the team that built these." />

  <section class="next" aria-labelledby="next-title">
    <h2 id="next-title" class="visually-hidden">What happens next</h2>
    <ol class="next__list" data-reveal>
      {
        next.map((n, i) => (
          <li class={`step step--${i}`}>
            <h3 class="step__line">{n.line}</h3>
            <p class="step__text">{n.text}</p>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 2rem;
    align-items: end;
    padding: clamp(3rem, 9vh, 7rem) var(--margin) 0;
  }
  .intro h1 { grid-column: 1 / 8; max-width: 10ch; }
  .intro__side { grid-column: 8 / 13; display: grid; gap: 1.5rem; }
  .intro__direct { display: flex; flex-wrap: wrap; gap: 0.5rem 1.75rem; font-weight: 600; }
  .next { padding: var(--section) var(--margin) 0; }
  .next__list { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 3.5rem; }
  .step { grid-column: 1 / -1; }
  .step--1 { grid-column-start: 3; }
  .step--2 { grid-column-start: 5; }
  .step__line { font-family: var(--display); font-weight: 600; font-size: var(--step-head); letter-spacing: -0.025em; line-height: 1; }
  .step__text { margin-top: 0.75rem; max-width: 36ch; color: var(--soft); }
  @media (max-width: 860px) {
    .intro h1, .intro__side { grid-column: 1 / -1; }
    .next__list { grid-template-columns: 1fr; row-gap: 2.5rem; }
    .step { grid-column: 1; }
    .step--1 { padding-left: 6vw; }
    .step--2 { padding-left: 12vw; }
  }
</style>

