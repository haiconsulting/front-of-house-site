---
// About. The story with a picture as its drop cap, where we work as display rows,
// how we work as lines that step across, then the work, the questions and the form.
import Base from "../layouts/Base.astro";
import LeadForm from "../components/LeadForm.astro";
import Faq from "../components/Faq.astro";
import WorkStrip from "../components/WorkStrip.astro";
import { site, faq, carePlans } from "../data/site.ts";

const places = [
  { place: "Park City, Utah", note: "Resort dining, where the first impression is the reservation." },
  { place: "Salt Lake City, Utah", note: "Where Killa, Burger Lab and Dasks are." },
  { place: "Metro Atlanta, Georgia", note: "Independents and small groups across the metro." },
];

const values = [
  { line: "We speak restaurant.", text: "Kitchen and hospitality language. We are insiders, not vendors." },
  { line: "Warm, never corporate.", text: "Confident and plainspoken. No buzzwords and no fluff." },
  { line: "We show, we don't oversell.", text: "The work and the food do the talking." },
  { line: "Service is the promise.", text: "Everything we do comes back to keeping you running, hands-on." },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.about.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Base
  title="About"
  description="Front of House is a web and brand studio built only for restaurants, founded in 2026 by restaurant operators and the builders behind Killa and Burger Lab. Park City, Salt Lake City and metro Atlanta."
  jsonLd={jsonLd}
>
  <section class="intro" aria-labelledby="about-title">
    <h1 id="about-title">Who is Front of House?</h1>
    <p class="lead" data-reveal><span>A web and brand studio built only for restaurants, founded in {site.foundingYear} in Park City, Utah and metro Atlanta, Georgia.</span></p>
  </section>

  <section class="story" aria-label="Our story">
    <div class="story__text" data-reveal>
      <p class="story__p">
        <img class="story__pic" src="/work/killa-aerial-square.jpg" width="720" height="720" alt="Downtown Salt Lake City at dusk, with Killa's lit windows in the foreground" loading="lazy" decoding="async" />
        <strong>{site.name}</strong> is a six-person studio built for one thing: restaurants. We shape your brand, capture your photos and video on site, build a custom website you own outright, then keep it sharp for a flat yearly fee.
      </p>
      <p class="story__p soft">
        Most of the industry rents you a site for $200 to $500 a month and bills you to touch it. We do the opposite: a real website you own, kept current for {carePlans[0].price} a year. Change it yourself or ask the Host, our AI. If you ever leave, you take your full code with you.
      </p>
      <p class="story__p soft">
        We come at this as hospitality people first, with co-founders from HAI, the studio that built Burger Lab and Killa. We know what a Friday rush feels like, why the right photo of a plate matters, and how much a slow website quietly costs in covers. So we build fast, we build to be found, and we stay on call.
      </p>
    </div>
  </section>

  <section class="places" aria-labelledby="places-title">
    <h2 id="places-title" class="visually-hidden">Where we work</h2>
    <ul class="places__rows" data-reveal>
      {
        places.map((p) => (
          <li class="place">
            <span class="place__name">{p.place}</span>
            <span class="place__note">{p.note}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="steps" aria-labelledby="values-title">
    <h2 id="values-title" class="visually-hidden">How we work</h2>
    <ol class="steps__list" data-reveal>
      {
        values.map((v, i) => (
          <li class={`step step--${i}`}>
            <h3 class="step__line">{v.line}</h3>
            <p class="step__text">{v.text}</p>
          </li>
        ))
      }
    </ol>
  </section>

  <WorkStrip statement="What the team has built so far." />
  <Faq heading="Questions about us" items={faq.about} />
  <LeadForm heading="Come meet the team" />
</Base>

<style>
  .intro {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    row-gap: 2rem;
    align-items: end;
    padding: clamp(3rem, 9vh, 7rem) var(--margin) 0;
  }
  .intro h1 { grid-column: 1 / 8; max-width: 12ch; }
  .intro .lead { grid-column: 8 / 13; max-width: 34ch; }
  .intro .lead span { display: block; }

  .story { padding: var(--section) var(--margin) 0; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); }
  .story__text { grid-column: 3 / 13; }
  .story__p { max-width: none; font-size: var(--step-lead); line-height: 1.32; }
  .story__p + .story__p { margin-top: 1.3em; }
  .story__p strong { font-weight: 600; }
  .story__pic { float: left; width: 3.9em; height: 3.9em; object-fit: cover; margin: 0.25em 0.6em 0 0; }

  .places { padding: var(--section) 0 0; }
  .places__rows { display: grid; }
  .place {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--gutter);
    align-items: end;
    min-height: 9rem;
    padding: 1.5rem var(--margin);
  }
  .place:nth-child(odd) { background: var(--surface); }
  .place:nth-child(2) { background: var(--toast); }
  .place__name { grid-column: 1 / 9; font-family: var(--display); font-weight: 600; font-size: var(--step-head); line-height: 1; letter-spacing: -0.02em; color: var(--ink); }
  .place__note { grid-column: 9 / 13; color: var(--soft); padding-bottom: 0.4rem; }

  .steps { padding: var(--section) var(--margin) 0; }
  .steps__list { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 3.5rem; }
  .step { grid-column: 1 / -1; }
  .step--1 { grid-column-start: 3; }
  .step--2 { grid-column-start: 5; }
  .step--3 { grid-column-start: 7; }
  .step__line { font-family: var(--display); font-weight: 600; font-size: var(--step-head); letter-spacing: -0.025em; line-height: 1; }
  .step--3 .step__line { color: var(--ember-deep); }
  .step__text { margin-top: 0.75rem; max-width: 34ch; color: var(--soft); }

  @media (max-width: 860px) {
    .intro h1, .intro .lead, .story__text { grid-column: 1 / -1; }
    .story__pic { width: 5.2em; height: 5.2em; }
    .place { grid-template-columns: 1fr; gap: 0.5rem; min-height: 0; padding-block: 1.75rem; }
    .place__name, .place__note { grid-column: 1; }
    .steps__list { grid-template-columns: 1fr; row-gap: 2.5rem; }
    .step { grid-column: 1; }
    .step--1 { padding-left: 6vw; }
    .step--2 { padding-left: 12vw; }
    .step--3 { padding-left: 18vw; }
  }
</style>
