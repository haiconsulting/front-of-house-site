---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { Image } from "astro:assets";
import killaPreview from "../../public/videos/killa-nikkei.jpg";
import { site, faq } from "../data/site.ts";

const principles = [
  {
    title: "Know the room.",
    body: "A Friday rush. A menu that changes. A guest looking for a table tonight. We build around the way restaurants actually work.",
  },
  {
    title: "Make it yours.",
    body: "Your name is on the door. Your website should belong to you, too. Custom code, full ownership, and your files if you ever move on.",
  },
  {
    title: "Stay in service.",
    body: "Launch is the beginning. Hosting, maintenance, and a real team to help keep the hours, menus, and details right.",
  },
];
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.about.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<Base
  title="About"
  description="Restaurant people and website people, at the same table. Meet Front of House, a six-founder restaurant web and brand studio based in Park City and metro Atlanta."
  jsonLd={jsonLd}
>
  <section class="about-hero" data-od-id="about-introduction">
    <div class="container">
      <div class="hero-topline">
        <p class="kicker">The people behind the welcome</p>
        <span>Est. 2026</span>
      </div>
      <h1>
        Hospitality people.
        <br /> <span>Website people.</span>
      </h1>
      <div class="hero-bottom">
        <p class="hero-note">
          One studio.
          <br /> Both sides of the table.
        </p>
        <p class="hero-intro">
          We believe the care you put into your restaurant should be felt before
          a guest walks through the door. That’s why we built Front of House.
        </p>
      </div>
    </div>
  </section>

  <section class="story-section" id="story" data-od-id="about-story">
    <div class="container story-grid">
      <div class="story-media">
        <div class="story-window">
          <Image
            src={killaPreview}
            alt="The Killa Nikkei restaurant website, with its food photography and gold-on-black identity"
            widths={[480, 800, 1280]}
            sizes="(max-width: 850px) 100vw, 50vw"
            loading="lazy"
          />
        </div>
        <p class="image-caption">
          <span>A little of our work</span>
          <a href="/work">
            Killa Nikkei, Salt Lake City <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
      <div class="story-copy">
        <p class="kicker">Our story</p>
        <h2>
          Built on a shared
          <br /> love of the industry.
        </h2>
        <p>
          Front of House brings six co-founders to one table: two
          restaurant-industry operators and four builders from HAI Solutions,
          the team behind the Killa and Burger Lab websites.
        </p>
        <p>
          We’re our own company, with a singular focus. We shape restaurant
          brands, capture their spaces and plates, and build websites that feel
          like an extension of the room.
        </p>
        <p>
          From Park City, Utah and metro Atlanta, Georgia, we work with
          independent restaurants and small groups. You get people who
          understand the business, and people who know how to build for it.
        </p>
        <a class="text-link" href="/services">
          Meet your new website team <span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>
  </section>

  <section class="ownership" data-od-id="about-ownership">
    <div class="container ownership-grid">
      <p class="kicker">The way we see it</p>
      <div>
        <h2>
          You built your restaurant.
          <br /> You should own
          <br /> your website.
        </h2>
        <div class="ownership-bottom">
          <p>
            Pay once for the build. Keep the code for good. Then a flat annual
            Care plan keeps it hosted and current, with our team behind you.
          </p>
          <a href="/pricing">
            Builds from $2,000
            <br /> <span>Care from $450 / year</span>
            <span class="ownership-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="principles-section" data-od-id="about-principles">
    <div class="container">
      <div class="section-heading">
        <p class="kicker">How we show up</p>
        <h2>
          Good service.
          <br /> All the way through.
        </h2>
      </div>
      <div class="principles">
        {principles.map((principle, i) => (
          <article class="principle">
            <span class="principle-number">0{i + 1}</span>
            <h3>{principle.title}</h3>
            <p>{principle.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="questions-section" id="faq" data-od-id="about-questions">
    <div class="container questions-grid">
      <div>
        <p class="kicker">A little more about us</p>
        <h2>Pull up a chair.</h2>
        <p class="question-intro">
          Something else on your mind?
          <br />{" "}
          <a href={`mailto:${site.contact.email}`}>
            Talk to Drew and the team <span aria-hidden="true">↗</span>
          </a>
        </p>
      </div>
      <div class="faq-list">
        {faq.about.map((item) => (
          <details class="faq-item">
            <summary>
              {item.q}
              <span aria-hidden="true">+</span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
  <CtaBand
    heading="Let’s make a proper introduction."
    sub="Tell us about your restaurant. We’ll take it from there."
  />
</Base>

<style>
  .about-hero {
    padding-block: clamp(3.5rem, 8vw, 7.5rem) clamp(3.5rem, 6vw, 5.5rem);
  }
  .hero-topline {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    margin-bottom: 2.5rem;
  }
  .hero-topline .kicker {
    margin: 0;
  }
  .hero-topline > span {
    font-size: 0.72rem;
    color: var(--muted);
  }
  h1 {
    font-size: clamp(3.2rem, 8.2vw, 7.6rem);
    font-weight: 550;
    line-height: 0.99;
    letter-spacing: -0.065em;
    margin-bottom: 2.8rem;
  }
  h1 > span {
    color: var(--ember);
  }
  .hero-bottom {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    align-items: end;
  }
  .hero-note {
    margin: 0;
    color: var(--muted);
    font-size: 0.84rem;
    line-height: 1.6;
  }
  .hero-intro {
    font-size: clamp(1.1rem, 1.65vw, 1.35rem);
    max-width: 40ch;
    margin: 0;
    line-height: 1.6;
  }
  .story-section {
    padding-block: clamp(3.5rem, 7vw, 6.5rem);
    background: var(--bone);
  }
  .story-grid {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
    align-items: center;
  }
  .story-window {
    aspect-ratio: 16/9;
    overflow: hidden;
    background: var(--ink);
  }
  .story-window :global(img) {
    height: 100%;
    width: 100%;
    border-radius: 0;
    object-fit: cover;
    object-position: center;
  }
  .image-caption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.4rem 1rem;
    font-size: 0.7rem;
    margin: 1rem 0 0;
  }
  .image-caption > span {
    color: var(--muted);
  }
  .image-caption a {
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    gap: 1.25rem;
    min-height: 44px;
  }
  .story-copy h2,
  .section-heading h2,
  .questions-grid h2 {
    font-size: clamp(2.1rem, 3.3vw, 3.25rem);
    letter-spacing: -0.05em;
    font-weight: 550;
    line-height: 1.1;
  }
  .story-copy h2 {
    margin-bottom: 1.5rem;
  }
  .story-copy > p:not(.kicker) {
    font-size: 1rem;
    line-height: 1.7;
  }
  .text-link {
    display: inline-flex;
    gap: 2rem;
    align-items: center;
    padding-block: 0.75rem;
    color: var(--ink);
    font-size: 0.86rem;
    font-weight: 600;
    border-bottom: 1px solid var(--ink);
  }
  .text-link:hover {
    color: var(--ember);
  }
  .ownership {
    padding-block: clamp(4rem, 8vw, 7rem);
    background: var(--ember);
    color: var(--paper);
  }
  .ownership-grid {
    display: grid;
    grid-template-columns: 0.42fr 1fr;
    gap: 2rem;
  }
  .ownership .kicker {
    color: var(--paper);
    padding-top: 0.7rem;
  }
  .ownership h2 {
    color: var(--paper);
    font-size: clamp(2.6rem, 5.3vw, 5rem);
    letter-spacing: -0.055em;
    font-weight: 500;
    line-height: 1.04;
    margin-bottom: 2.7rem;
  }
  .ownership-bottom {
    display: grid;
    grid-template-columns: 1fr 0.85fr;
    gap: 2.5rem;
    align-items: start;
  }
  .ownership-bottom p {
    font-size: 1rem;
    margin: 0;
    max-width: 37ch;
  }
  .ownership-bottom a {
    color: var(--paper);
    font-weight: 600;
    padding-bottom: 1rem;
    border-bottom: 1px solid currentColor;
    position: relative;
    padding-right: 2rem;
    font-size: 1rem;
  }
  .ownership-bottom a > span:not(.ownership-arrow) {
    font-size: 0.8rem;
    font-weight: 400;
  }
  .ownership-arrow {
    position: absolute;
    right: 0;
    top: 0;
    font-size: 1.3rem;
  }
  .ownership a:focus-visible {
    outline-color: var(--paper);
  }
  .principles-section {
    padding-block: clamp(4rem, 8vw, 7rem);
  }
  .section-heading {
    display: grid;
    grid-template-columns: 0.42fr 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }
  .section-heading .kicker {
    padding-top: 0.7rem;
  }
  .principles {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3rem;
  }
  .principle {
    padding-top: 1.3rem;
    border-top: 1px solid var(--line);
  }
  .principle-number {
    display: block;
    font-size: 0.72rem;
    color: var(--ember);
    margin-bottom: 2.3rem;
  }
  .principle h3 {
    font-size: 1.55rem;
    letter-spacing: -0.035em;
    margin-bottom: 1rem;
    font-weight: 550;
  }
  .principle p {
    font-size: 0.95rem;
    line-height: 1.7;
    margin: 0;
    max-width: 37ch;
  }
  .questions-section {
    padding-block: clamp(4rem, 7vw, 6rem);
    background: var(--bone);
  }
  .questions-grid {
    display: grid;
    grid-template-columns: 0.8fr 1fr;
    gap: clamp(2rem, 6vw, 6rem);
  }
  .question-intro {
    font-size: 0.9rem;
    margin: 1.5rem 0 0;
  }
  .question-intro a {
    display: inline-block;
    padding-block: 0.6rem;
  }
  .faq-item {
    border-bottom: 1px solid var(--line);
  }
  .faq-item:first-child {
    border-top: 1px solid var(--line);
  }
  .faq-item summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1.4rem;
    color: var(--ink);
    font-weight: 550;
    font-size: 0.98rem;
    line-height: 1.5;
  }
  .faq-item summary::-webkit-details-marker {
    display: none;
  }
  .faq-item summary > span {
    color: var(--ember);
    font-size: 1.5rem;
    flex: none;
    font-weight: 400;
  }
  .faq-item[open] summary > span {
    transform: rotate(45deg);
  }
  .faq-item > p {
    padding-bottom: 1.4rem;
    font-size: 0.94rem;
    line-height: 1.7;
    max-width: 62ch;
    margin: 0;
  }
  @media (max-width: 850px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
    .story-window {
      aspect-ratio: 16/9;
    }
    .story-copy {
      max-width: 65ch;
    }
    .ownership-grid,
    .section-heading {
      grid-template-columns: 1fr;
      gap: 1.25rem;
    }
    .ownership h2 {
      max-width: 17ch;
    }
    .principles {
      gap: 1.5rem;
    }
    .questions-grid {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
  }
  @media (max-width: 560px) {
    .hero-topline {
      margin-bottom: 2rem;
    }
    .hero-topline > span {
      display: none;
    }
    h1 {
      font-size: clamp(2.8rem, 10.4vw, 3.9rem);
      letter-spacing: -0.06em;
    }
    .hero-bottom {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }
    .ownership-bottom {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .ownership-bottom a {
      max-width: 19rem;
    }
    .principles {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .principle-number {
      margin-bottom: 1.25rem;
    }
    .principle p {
      font-size: 1rem;
    }
    .story-copy > p:not(.kicker),
    .faq-item > p {
      font-size: 1rem;
    }
  }
</style>
